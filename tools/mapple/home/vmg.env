# Read by the driver when it makes its device (vmg_screen.c load_env_file): KEY=VALUE, not over the environment.
# A new copy of this file restarts backboardd by itself (SweetMapple.m), so a change needs one boot and no build.
#
# AFBC off: the first failing fragment jobs sampled AFBC textures at unaligned pointers (fetch8). With it off
# (fetch9-10) the same draws still fail, so AFBC was not the cause; it stays off until the cause is known.
PAN_MESA_DEBUG=noafbc
# IDVS off: every failing pass draws through an IDVS ("Indexed Vertex") job whose fragment half has no varying
# descriptors while two of the vertex half's varyings are "Constant" (unused); the fault is in the batch's descriptor
# memory (ADDR_RANGE_FAULT). Without IDVS, Panfrost uses separate vertex and tiler jobs, decoded in full on a failure.
BIFROST_MESA_DEBUG=noidvs
