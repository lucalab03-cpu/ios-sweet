# Read by the driver when it makes its device (vmg_screen.c load_env_file): KEY=VALUE, not over the environment.
# AFBC off: on the G52 every fragment job that failed (ADDR_RANGE_FAULT / IMPRECISE_FAULT) sampled an AFBC texture
# whose surface pointer was not 64-byte aligned (0x...030, 0x...031; boot 2026-11-23, fetch8). Remove the line to
# give AFBC back (one dropbox file).
PAN_MESA_DEBUG=noafbc
