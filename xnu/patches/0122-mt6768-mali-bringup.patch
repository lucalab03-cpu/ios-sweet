diff --git a/bsd/dev/sweet_mali.c b/bsd/dev/sweet_mali.c
new file mode 100644
index 0000000..c56a008
--- /dev/null
+++ b/bsd/dev/sweet_mali.c
@@ -0,0 +1,451 @@
+/*
+ * Moto G05 (MT6768 "lamu") Mali-G52 MC2 bring-up from XNU, steps 1 to 6.
+ *
+ * A Bifrost Mali needs no firmware: bringing it up is clocks, power and a reset, in MediaTek's order.
+ * The sequence and the job format follow the HakiOS projects that already run this GPU from XNU
+ * (hakios-mt6768 for the Infinix Hot 20, same SoC, and hakios-a32; their kernel files are Apple
+ * Public Source License 2.0, as this file is), cross-checked against MediaTek's own drivers
+ * (clk-mt6768-pg.c, gpufreq_mt6768.c) and Linux's panfrost register map.
+ *
+ *   1  the "mfg_sel" clock mux in topckgen, to syspll_d3 (364 MHz)
+ *   2  the four SPM power domains MFG_ASYNC, MFG, MFG_CORE0, MFG_CORE1, each with its SRAM; once
+ *      MFG has power, the bus protection between the GPU block and the rest is released
+ *   3  the block's own clock gate (BG3D in mfgcfg)
+ *   4  the GPU: identity, soft reset, L2, tiler and both shader cores powered
+ *   5  the smallest job there is (write a value into memory) in address space 0, identity mode
+ *   6  the same job through the GPU's own page tables
+ *
+ * The PMIC rails VGPU and VSRAM_GPU are not touched: on this phone Linux's lamu_gpu.ko (which calls
+ * gpufreq_power_control) leaves them and the domains on before the jump.
+ *
+ * Boot-args: sweetmali=0 (default, off) | 1 (steps 1-4) | 2 (all six steps),
+ *            sweetmalidelay=<s> (default 30). sysctl kern.sweetmali (read-only) says how far it got.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/sysctl.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+#include <arm/caches_internal.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+extern addr64_t kvtophys(vm_offset_t va);
+extern vm_offset_t phystokv(uint64_t pa);
+void sweet_mali_init(void);
+
+#define TOPCKGEN_PA     0x10000000u
+#define INFRACFG_PA     0x10001000u
+#define SPM_PA          0x10006000u
+#define MFGCFG_PA       0x13000000u
+#define MALI_PA         0x13040000u
+
+#define PWR_STATUS      0x180u
+#define PWR_STATUS_2ND  0x184u
+#define PWR_RST_B       (1u << 0)
+#define PWR_ISO         (1u << 1)
+#define PWR_ON          (1u << 2)
+#define PWR_ON_2ND      (1u << 3)
+#define PWR_CLK_DIS     (1u << 4)
+#define PWR_SRAM_PDN    (1u << 8)
+#define PWR_SRAM_ACK    (1u << 12)
+
+#define CLK_CFG_1_SET   0x54u
+#define CLK_CFG_1_CLR   0x58u
+#define TOPAXI_PROT_STA1 0x228u
+#define TOPAXI_PROT_CLR  0x2a4u
+#define MFG_CG_CLR      0x008u
+
+/* Mali registers (Linux drivers/gpu/drm/panfrost/panfrost_regs.h) */
+#define GPU_ID              0x000u
+#define GPU_INT_RAWSTAT     0x020u
+#define GPU_INT_CLEAR       0x024u
+#define GPU_INT_MASK        0x028u
+#define GPU_CMD             0x030u
+#define SHADER_PRESENT      0x100u
+#define TILER_PRESENT       0x110u
+#define L2_PRESENT          0x120u
+#define SHADER_READY        0x140u
+#define TILER_READY         0x150u
+#define L2_READY            0x160u
+#define SHADER_PWRON        0x180u
+#define TILER_PWRON         0x190u
+#define L2_PWRON            0x1a0u
+#define IRQ_RESET_COMPLETED (1u << 8)
+
+#define JOB_INT_RAWSTAT     0x1000u
+#define JOB_INT_CLEAR       0x1004u
+#define JOB_INT_MASK        0x1008u
+#define JS1                 0x1880u
+#define JS_STATUS           0x24u
+#define JS_HEAD_NEXT_LO     0x40u
+#define JS_HEAD_NEXT_HI     0x44u
+#define JS_AFFINITY_NEXT_LO 0x50u
+#define JS_AFFINITY_NEXT_HI 0x54u
+#define JS_CONFIG_NEXT      0x58u
+#define JS_COMMAND_NEXT     0x60u
+#define JS_CONFIG           ((3u << 8) | (3u << 12) | (8u << 16))   /* AS 0, caches flushed at both ends */
+
+#define AS0                 0x2400u
+#define AS_TRANSTAB_LO      0x00u
+#define AS_TRANSTAB_HI      0x04u
+#define AS_MEMATTR_LO       0x08u
+#define AS_MEMATTR_HI       0x0cu
+#define AS_COMMAND          0x18u
+#define AS_FAULTSTATUS      0x1cu
+#define AS_STATUS           0x28u
+#define AS_TRANSCFG_LO      0x30u
+#define AS_TRANSCFG_HI      0x34u
+
+/* AArch64 stage-1 format, 4 KB pages, 35 address bits (MMU_FEATURES 0x2823 on this GPU): 3 levels */
+#define PTE_TABLE           3ull
+#define PTE_PAGE            3ull
+#define PTE_AF              (1ull << 10)
+#define PTE_SH_INNER        (3ull << 8)
+#define PTE_AP_RW           (1ull << 6)
+#define PTE_ADDRESS         0x0000fffffffff000ull
+#define TRANSCFG_AARCH64_4K (6u | (20u << 6) | (2u << 24) | (1u << 30))
+#define FIRST_JOB_GPU       0x00100000ull
+
+static const struct {
+	const char *name;
+	uint32_t con, status;
+	bool sram;
+} domains[4] = {
+	{ "MFG_ASYNC", 0x334, 1u << 14, false },
+	{ "MFG", 0x338, 1u << 11, true },
+	{ "MFG_CORE0", 0x34c, 1u << 12, true },
+	{ "MFG_CORE1", 0x310, 1u << 13, true },
+};
+
+static vm_offset_t topckgen, infracfg, spm, mfgcfg, mali;
+static uint32_t reached, gpu_id, shader_mask;
+static uint64_t *pt_top;
+static uint64_t pt_top_phys;
+static int mali_sleep_chan;
+static bool mali_started;
+
+SYSCTL_NODE(, OID_AUTO, sweetmali, CTLFLAG_RW | CTLFLAG_LOCKED, 0, "SWEET Mali");
+SYSCTL_UINT(_sweetmali, OID_AUTO, step, CTLFLAG_RD | CTLFLAG_LOCKED, &reached, 0, "how far the Mali came up (6 = job through page tables)");
+SYSCTL_UINT(_sweetmali, OID_AUTO, id, CTLFLAG_RD | CTLFLAG_LOCKED, &gpu_id, 0, "GPU_ID");
+
+static inline uint32_t
+rd(vm_offset_t base, uint32_t at)
+{
+	uint32_t v = *(volatile uint32_t *)(base + at);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr(vm_offset_t base, uint32_t at, uint32_t value)
+{
+	__asm__ volatile ("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + at) = value;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static void
+mali_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&mali_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+/* Until (register & mask) == want, for at most ms. */
+static bool
+wait_for(vm_offset_t base, uint32_t at, uint32_t mask, uint32_t want, uint32_t ms)
+{
+	for (uint32_t us = 0; us < ms * 1000; us += 10) {
+		if ((rd(base, at) & mask) == want) {
+			return true;
+		}
+		delay(10);
+	}
+	return (rd(base, at) & mask) == want;
+}
+
+static bool
+domain_on(unsigned i)
+{
+	uint32_t con = domains[i].con, bit = domains[i].status;
+
+	wr(spm, con, rd(spm, con) | PWR_ON);
+	wr(spm, con, rd(spm, con) | PWR_ON_2ND);
+	if (!wait_for(spm, PWR_STATUS, bit, bit, 20) || !wait_for(spm, PWR_STATUS_2ND, bit, bit, 20)) {
+		return false;
+	}
+	wr(spm, con, rd(spm, con) & ~PWR_CLK_DIS);
+	wr(spm, con, rd(spm, con) & ~PWR_ISO);
+	wr(spm, con, rd(spm, con) | PWR_RST_B);
+	if (domains[i].sram) {
+		wr(spm, con, rd(spm, con) & ~PWR_SRAM_PDN);
+		return wait_for(spm, con, PWR_SRAM_ACK, 0, 20);
+	}
+	return true;
+}
+
+/*
+ * The smallest job: a header saying "write value" and its payload (where, what kind of value, the
+ * value), the "where" being the same page 0x800 further on. gpu is the address the GPU knows the page
+ * by. The processor's caches are flushed either side: the GPU does not look into them.
+ */
+static bool
+run_write_job(vm_offset_t page, uint64_t gpu, const char *what)
+{
+	volatile uint32_t *job = (volatile uint32_t *)page, *target = (volatile uint32_t *)(page + 0x800);
+	bool ok;
+
+	bzero((void *)page, PAGE_SIZE);
+	job[4] = (2u << 1) | 1u | (1u << 16);   /* write value; 64-bit pointers; job index 1 */
+	job[8] = (uint32_t)(gpu + 0x800);
+	job[9] = (uint32_t)((gpu + 0x800) >> 32);
+	job[10] = 6;                            /* a 32-bit immediate */
+	job[12] = 0xc0ffee01u;
+	FlushPoC_DcacheRegion(page, PAGE_SIZE);
+
+	wr(mali, JOB_INT_MASK, 0);
+	wr(mali, JOB_INT_CLEAR, 0xffffffffu);
+	wr(mali, JS1 + JS_HEAD_NEXT_LO, (uint32_t)gpu);
+	wr(mali, JS1 + JS_HEAD_NEXT_HI, (uint32_t)(gpu >> 32));
+	wr(mali, JS1 + JS_AFFINITY_NEXT_LO, shader_mask);
+	wr(mali, JS1 + JS_AFFINITY_NEXT_HI, 0);
+	wr(mali, JS1 + JS_CONFIG_NEXT, JS_CONFIG);
+	wr(mali, JS1 + JS_COMMAND_NEXT, 1);     /* start */
+	(void)wait_for(mali, JOB_INT_RAWSTAT, (1u << 1) | (1u << 17), 1u << 1, 100);
+
+	FlushPoC_DcacheRegion(page, PAGE_SIZE);
+	ok = *target == 0xc0ffee01u;
+	printf("SWEET MALI: %s: job irq %#x, slot status %#x, MMU fault %#x, job status %#x, word %#x%s\n", what,
+	    rd(mali, JOB_INT_RAWSTAT), rd(mali, JS1 + JS_STATUS), rd(mali, AS0 + AS_FAULTSTATUS), job[0], *target,
+	    ok ? " -- the GPU ran it" : " -- NOT WRITTEN");
+	wr(mali, JOB_INT_CLEAR, 0xffffffffu);
+	return ok;
+}
+
+static void
+as0_update(uint64_t transtab, uint32_t transcfg)
+{
+	wr(mali, AS0 + AS_TRANSTAB_LO, (uint32_t)transtab);
+	wr(mali, AS0 + AS_TRANSTAB_HI, (uint32_t)(transtab >> 32));
+	wr(mali, AS0 + AS_TRANSCFG_LO, transcfg);
+	wr(mali, AS0 + AS_TRANSCFG_HI, 0);
+	wr(mali, AS0 + AS_MEMATTR_LO, 0x88888888u);
+	wr(mali, AS0 + AS_MEMATTR_HI, 0x88888888u);
+	wr(mali, AS0 + AS_COMMAND, 1);          /* update */
+	(void)wait_for(mali, AS0 + AS_STATUS, 1, 0, 50);
+}
+
+/* One zeroed, wired page the GPU can reach: its kernel address, and its physical one. */
+static vm_offset_t
+phys_page(uint64_t *phys)
+{
+	vm_offset_t va = 0;
+
+	if (kmem_alloc_contig(kernel_map, &va, PAGE_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return 0;
+	}
+	*phys = kvtophys(va);
+	FlushPoC_DcacheRegion(va, PAGE_SIZE);
+	return va;
+}
+
+static uint64_t *
+pt_below(uint64_t *entry)
+{
+	uint64_t phys;
+	vm_offset_t table;
+
+	if (*entry & 1) {
+		return (uint64_t *)phystokv(*entry & PTE_ADDRESS);
+	}
+	if ((table = phys_page(&phys)) == 0) {
+		return NULL;
+	}
+	*entry = phys | PTE_TABLE;
+	FlushPoC_DcacheRegion((vm_offset_t)entry, sizeof(*entry));
+	return (uint64_t *)table;
+}
+
+/* One 4 KB page of physical memory at GPU address gpu. */
+static bool
+map_page(uint64_t gpu, uint64_t phys)
+{
+	uint64_t *middle, *bottom, *entry;
+
+	if (pt_top == NULL) {
+		pt_top = (uint64_t *)phys_page(&pt_top_phys);
+		if (pt_top == NULL) {
+			return false;
+		}
+	}
+	if ((middle = pt_below(&pt_top[(gpu >> 30) & 31])) == NULL ||
+	    (bottom = pt_below(&middle[(gpu >> 21) & 511])) == NULL) {
+		return false;
+	}
+	entry = &bottom[(gpu >> 12) & 511];
+	*entry = (phys & PTE_ADDRESS) | PTE_AF | PTE_SH_INNER | PTE_AP_RW | PTE_PAGE;
+	FlushPoC_DcacheRegion((vm_offset_t)entry, sizeof(*entry));
+	return true;
+}
+
+/* Step 5, then step 6. Returns how many worked. */
+static unsigned
+first_jobs(void)
+{
+	uint64_t phys = 0;
+	vm_offset_t page = phys_page(&phys);
+	unsigned done = 0;
+
+	if (page == 0) {
+		printf("SWEET MALI: no page for the first jobs\n");
+		return 0;
+	}
+	as0_update(0, 2);                       /* identity: a GPU address is the physical one */
+	if (run_write_job(page, phys, "first job, identity mode")) {
+		done = 1;
+		if (map_page(FIRST_JOB_GPU, phys)) {
+			as0_update(pt_top_phys, TRANSCFG_AARCH64_4K);
+			if (run_write_job(page, FIRST_JOB_GPU, "second job, through the GPU's page tables")) {
+				done = 2;
+			}
+		} else {
+			printf("SWEET MALI: no memory for page tables\n");
+		}
+	}
+	return done;
+}
+
+static void
+mali_up(int mode)
+{
+	uint32_t shaders, tiler, l2;
+
+	topckgen = ml_io_map(TOPCKGEN_PA, 0x1000);
+	infracfg = ml_io_map(INFRACFG_PA, 0x1000);
+	spm = ml_io_map(SPM_PA, 0x1000);
+	if (!topckgen || !infracfg || !spm) {
+		printf("SWEET MALI: mapping failed\n");
+		return;
+	}
+	printf("SWEET MALI: before: PWR_STATUS %#x 2ND %#x, CLK_CFG_1 %#x, bus protection STA1 %#x\n",
+	    rd(spm, PWR_STATUS), rd(spm, PWR_STATUS_2ND), rd(topckgen, 0x50), rd(infracfg, TOPAXI_PROT_STA1));
+
+	/* 1: the clock; 2: power */
+	wr(topckgen, CLK_CFG_1_CLR, 3u | (1u << 7));    /* mfg_sel's source and its gate */
+	wr(topckgen, CLK_CFG_1_SET, 2u);                /* syspll_d3 */
+	reached = 1;
+	for (unsigned i = 0; i < 4; i++) {
+		if (!domain_on(i)) {
+			printf("SWEET MALI: power domain %s did not come up (PWR_STATUS %#x)\n", domains[i].name,
+			    rd(spm, PWR_STATUS));
+			return;
+		}
+		if (i == 1) {
+			wr(infracfg, TOPAXI_PROT_CLR, (1u << 21) | (1u << 22));   /* bus protection released */
+			wr(infracfg, TOPAXI_PROT_CLR, 1u << 25);
+		}
+	}
+	reached = 2;
+	printf("SWEET MALI: domains up: PWR_STATUS %#x, bus protection STA1 %#x\n", rd(spm, PWR_STATUS),
+	    rd(infracfg, TOPAXI_PROT_STA1));
+
+	/* 3: inside the block, which now has power and a bus */
+	mfgcfg = ml_io_map(MFGCFG_PA, 0x1000);
+	mali = ml_io_map(MALI_PA, 0x4000);
+	if (!mfgcfg || !mali) {
+		printf("SWEET MALI: GPU mapping failed\n");
+		return;
+	}
+	wr(mfgcfg, MFG_CG_CLR, 1u);             /* BG3D runs */
+	reached = 3;
+
+	/* 4: the GPU itself */
+	gpu_id = rd(mali, GPU_ID);
+	shaders = shader_mask = rd(mali, SHADER_PRESENT);
+	tiler = rd(mali, TILER_PRESENT);
+	l2 = rd(mali, L2_PRESENT);
+	wr(mali, GPU_INT_MASK, 0);
+	wr(mali, GPU_INT_CLEAR, 0xffffffffu);
+	wr(mali, GPU_CMD, 1);                   /* soft reset */
+	if (!wait_for(mali, GPU_INT_RAWSTAT, IRQ_RESET_COMPLETED, IRQ_RESET_COMPLETED, 100)) {
+		printf("SWEET MALI: GPU_ID %#x, but it did not finish its reset\n", gpu_id);
+		return;
+	}
+	wr(mali, GPU_INT_CLEAR, 0xffffffffu);
+	wr(mali, L2_PWRON, l2);
+	wr(mali, TILER_PWRON, tiler);
+	wr(mali, SHADER_PWRON, shaders);
+	if (!wait_for(mali, L2_READY, l2, l2, 50) || !wait_for(mali, TILER_READY, tiler, tiler, 50) ||
+	    !wait_for(mali, SHADER_READY, shaders, shaders, 50)) {
+		printf("SWEET MALI: GPU_ID %#x, but its cores did not all power up (shaders ready %#x)\n", gpu_id,
+		    rd(mali, SHADER_READY));
+		return;
+	}
+	reached = 4;
+	printf("SWEET MALI: GPU_ID %#x (Mali-G52 r%up%u), shader cores %#x, tiler %#x, L2 %#x: all powered\n", gpu_id,
+	    (gpu_id >> 12) & 0xf, (gpu_id >> 4) & 0xff, shaders, tiler, l2);
+	if (mode < 2) {
+		return;
+	}
+
+	/* 5 and 6 */
+	switch (first_jobs()) {
+	case 2:
+		reached = 6;
+		break;
+	case 1:
+		reached = 5;
+		break;
+	default:
+		break;
+	}
+	printf("SWEET MALI: came up to step %u of 6\n", reached);
+}
+
+static void
+mali_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 30;
+	int mode = 0;
+	(void)arg;
+	(void)result;
+	(void)PE_parse_boot_argn("sweetmali", &mode, sizeof(mode));
+	(void)PE_parse_boot_argn("sweetmalidelay", &delay_s, sizeof(delay_s));
+	printf("SWEET MALI: mode %d, starting in %u s\n", mode, delay_s);
+	mali_wait(delay_s * 1000u);
+	mali_up(mode);
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_mali_init(void)
+{
+	int mode = 0;
+	thread_t thread;
+
+	if (mali_started) {
+		return;
+	}
+	mali_started = true;
+	(void)PE_parse_boot_argn("sweetmali", &mode, sizeof(mode));
+	if (mode <= 0) {
+		return;
+	}
+	if (kernel_thread_start(mali_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET MALI: kernel_thread_start failed\n");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 6b8d3ad..b44e8f1 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -48,6 +48,7 @@ extern void sweet_sample_start(void);
 extern void sweet_keys_init(void);
 extern void sweet_conn_init(void);
 extern void sweet_gpu_init(void);
+extern void sweet_mali_init(void);
 extern void sweet_touch_init(void);
 extern void sweet_usb_probe(void);
 
@@ -1074,6 +1075,7 @@ sweet_ufs_init(void)
 	sweet_touch_init();
 	sweet_conn_init();
 	sweet_gpu_init();
+	sweet_mali_init();
 	/* MT6768: the Qualcomm keys/touch/usb drivers would hit unmapped buses; not started. */
 	return 0;
 }
