 /* Nearest-neighbour blit of a logical-display rectangle onto the panel. */
+/*
+ * Patch 0149: the source rows are read once each, with memcpy (16-byte loads), into a cached two-row buffer, and the
+ * gather and the averages read from there. The copy took 11.5-12.4 ms whatever the core (A55 1.7 GHz, A75 2.0 GHz) and
+ * whatever the panel mapping (write-combined or cached, 0148), so the 4-byte loads from the surface are what is slow.
+ * The time spent reading the rows is reported in the stats ("source rows read").
+ */
+#define SWEET_FB_ROW_MAX 4096
+static uint32_t sweet_fb_row[2][SWEET_FB_ROW_MAX];
+static int32_t sweet_fb_row_y[2];
+
+static const uint32_t *
+sweet_fb_row_load(uintptr_t base, uint32_t bpr, int32_t r, uint32_t pixels, int32_t keep)
+{
+	for (int i = 0; i < 2; i++) {
+		if (sweet_fb_row_y[i] == r) {
+			return sweet_fb_row[i];
+		}
+	}
+	int v = sweet_fb_row_y[0] == keep ? 1 : 0;
+	memcpy(sweet_fb_row[v], (const void *)(base + (uint64_t)r * bpr), (size_t)pixels * 4);
+	sweet_fb_row_y[v] = r;
+	return sweet_fb_row[v];
+}
