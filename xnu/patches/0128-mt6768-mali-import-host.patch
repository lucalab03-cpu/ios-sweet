+/* With the lock held: a free handle, or NULL. */
+struct sweet_mali_buffer *
+SweetMaliUserClient::freeSlot(uint32_t * handle)
+{
+	for (uint32_t n = 0; n < SWEET_MALI_BUFFERS; n++) {
+		uint32_t i = (fNextBuffer + n) % SWEET_MALI_BUFFERS;
+
+		if (fBuffers[i].memory == NULL && fBuffers[i].imported == NULL) {
+			*handle = i + 1;
+			fNextBuffer = i + 1;
+			return &fBuffers[i];
+		}
+	}
+	IOLog("SweetMali: no handles left\n");
+	return NULL;
+}
+
+/*
+ * With the lock held. IMPORT_HOST: the caller's own pages (an IOSurface's, a malloc'd buffer) become a buffer the GPU
+ * reads and writes in place: wired for as long as the buffer lives, entered into the GPU's address space 4 KB at a
+ * time. Mesa's PanVK uses it for VK_EXT_external_memory_host, which the Metal runtime needs for IOSurfaces. The pages
+ * stay cached for the processor: the program cleans and invalidates them around the GPU's use (the Metal driver's
+ * sys_dcache_flush), as the frontend does for surfaces.
+ */
+IOReturn
+SweetMaliUserClient::importHost(struct sweet_import_host * request)
+{
+	struct sweet_mali_buffer * b;
+	IOMemoryDescriptor * memory;
+	uint32_t handle = 0;
+	bool mapped = true;
+
+	if (request->address == 0 || request->size == 0 || request->size > SWEET_MALI_BUFFER_MAX ||
+	    (request->address & PAGE_MASK) != 0 || (request->size & PAGE_MASK) != 0) {
+		return kIOReturnBadArgument;
+	}
+	b = freeSlot(&handle);
+	if (b == NULL) {
+		return kIOReturnNoResources;
+	}
+	memory = IOMemoryDescriptor::withAddressRange((mach_vm_address_t) request->address, (mach_vm_size_t) request->size,
+	    kIODirectionInOut, current_task());
+	if (memory == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (memory->prepare() != kIOReturnSuccess) {
+		memory->release();
+		IOLog("SweetMali: the pages at %#llx (%llu bytes) cannot be wired\n", request->address, request->size);
+		return kIOReturnVMError;
+	}
+	b->address = sweet_mali_address(request->size);
+	for (uint64_t offset = 0; offset < request->size && mapped && b->address != 0; offset += 4096) {
+		IOByteCount length = 0;
+		addr64_t phys = memory->getPhysicalSegment(offset, &length, kIOMemoryMapperNone);
+
+		mapped = phys != 0 && sweet_mali_map(b->address + offset, phys);
+	}
+	if (b->address == 0 || !mapped) {
+		if (b->address != 0) {
+			sweet_mali_unmap(b->address, request->size);
+		}
+		bzero(b, sizeof(*b));
+		memory->complete();
+		memory->release();
+		IOLog("SweetMali: imported pages of %llu bytes cannot be entered into the GPU's address space\n", request->size);
+		return kIOReturnNoMemory;
+	}
+	sweet_mali_mapped();
+	b->imported = memory;
+	b->size = request->size;
+	request->handle = handle;
+	request->offset = b->address;
+	return kIOReturnSuccess;
+}
+
