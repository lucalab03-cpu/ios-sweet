+struct sw_gpd {
+	uint32_t info, next, ptr, len, arg, blknum, cmd;
+};
+struct sw_bd {
+	uint32_t info, next, ptr, len;
+};
+
+static uint8_t
+dma_cs(const void *p, unsigned n)
+{
+	const uint8_t *b = p;
+	uint32_t sum = 0;
+
+	for (unsigned i = 0; i < n; i++) {
+		sum += b[i];
+	}
+	return (uint8_t)(0xffu - sum);
+}
+
+static void
+msdc_dma_stop(void)
+{
+	ufs_wr(M_DMA_CTRL, ufs_rd(M_DMA_CTRL) | DMA_CTRL_STOP);
+	(void)msdc_poll(M_DMA_CFG, DMA_CFG_STS, 0, 20ull * NSEC_PER_MSEC);
+	msdc_clear_fifo_and_int();
+}
+
+/*
+ * Transfer nsec sectors between the card and the bounce buffer with the MSDC DMA engine.
+ * Everything (descriptors and data) lies below 4 GiB, so no high address bits are needed.
+ */
+static int
+msdc_dma_xfer(uint32_t sector, uint32_t nsec, bool write)
+{
+	struct sw_gpd *gpd = (struct sw_gpd *)(su.dma + DMA_GPD_OFF);
+	struct sw_bd *bd = (struct sw_bd *)(su.dma + DMA_BD_OFF);
+	uint64_t gpd_pa = su.dma_pa + DMA_GPD_OFF;
+	uint64_t bd_pa = su.dma_pa + DMA_BD_OFF;
+	uint64_t buf_pa = su.dma_pa + DMA_BOUNCE;
+	uint32_t len = nsec * EMMC_SECTOR;
+	unsigned n = (len + DMA_BD_CHUNK - 1) / DMA_BD_CHUNK;
+	uint64_t deadline;
+	uint32_t st = 0;
+	int error;
+
+	if (!su.dma_mem || n == 0 || n > 32) {
+		return EINVAL;
+	}
+	memset(gpd, 0, 2 * sizeof(*gpd));
+	memset(bd, 0, n * sizeof(*bd));
+	for (unsigned i = 0; i < n; i++) {
+		uint32_t l = len - i * DMA_BD_CHUNK;
+
+		if (l > DMA_BD_CHUNK) {
+			l = DMA_BD_CHUNK;
+		}
+		bd[i].ptr = (uint32_t)(buf_pa + (uint64_t)i * DMA_BD_CHUNK);
+		bd[i].len = l;
+		bd[i].next = (i + 1 < n) ? (uint32_t)(bd_pa + (uint64_t)(i + 1) * sizeof(*bd)) : 0;
+		bd[i].info = (i + 1 == n) ? 1u : 0u;    /* EOL on the last one */
+		bd[i].info |= (uint32_t)dma_cs(&bd[i], 16) << 8;
+	}
+	gpd->info = 3u;                                 /* HWO | BDP */
+	gpd->next = (uint32_t)(gpd_pa + sizeof(*gpd));
+	gpd->ptr = (uint32_t)bd_pa;
+	gpd->info |= (uint32_t)dma_cs(gpd, 16) << 8;
+	flush_dcache64(su.dma_pa, DMA_BOUNCE, 1);
+	flush_dcache64(buf_pa, len, 1);
+
+	ufs_wr(M_CFG, ufs_rd(M_CFG) & ~CFG_PIO);
+	ufs_wr(M_DMA_CFG, ufs_rd(M_DMA_CFG) | DMA_CFG_DECSEN);
+	ufs_wr(M_DMA_CTRL, (ufs_rd(M_DMA_CTRL) & ~(DMA_BURST_MASK | DMA_CTRL_START | DMA_CTRL_STOP)) |
+	    DMA_BURST_64B | DMA_CTRL_DESC);
+	ufs_wr(M_DMA_H4, ufs_rd(M_DMA_H4) & ~0xfu);
+	ufs_wr(M_DMA_SA, (uint32_t)gpd_pa);
+	ufs_wr(M_DMA_CTRL, ufs_rd(M_DMA_CTRL) | DMA_CTRL_START);
+
+	if (write) {
+		error = msdc_cmd(nsec == 1 ? 24 : 25, sector, 1, nsec == 1 ? 1 : 2, nsec,
+		    CMD_WRITE | (nsec == 1 ? 0 : CMD_AUTO12), NULL);
+	} else {
+		error = msdc_cmd(nsec == 1 ? 17 : 18, sector, 1, nsec == 1 ? 1 : 2, nsec,
+		    nsec == 1 ? 0 : CMD_AUTO12, NULL);
+	}
+	if (!error) {
+		nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+		deadline += mach_absolute_time();
+		for (;;) {
+			st = ufs_rd(M_INT);
+			if (st & (INT_XFER_COMPL | INT_DATTMO | INT_DATCRC | INT_DMA_ERR)) {
+				break;
+			}
+			if (mach_absolute_time() > deadline) {
+				error = ETIMEDOUT;
+				break;
+			}
+		}
+		if (!error && (!(st & INT_XFER_COMPL) || (st & (INT_DATTMO | INT_DATCRC | INT_DMA_ERR)))) {
+			error = EIO;
+		}
+	}
+	if (error) {
+		printf("SWEET EMMC: DMA %s of %u sectors at 0x%x failed (%d, int %#x)\n",
+		    write ? "write" : "read", nsec, sector, error, st);
+		msdc_dma_stop();
+	} else {
+		ufs_wr(M_INT, ufs_rd(M_INT));
+		if (!write) {
+			flush_dcache64(buf_pa, len, 1);         /* drop stale lines */
+		}
+		if (!msdc_poll(M_SDC_STS, STS_SDCBUSY, 0, CMD_TIMEOUT_NS)) {
+			error = ETIMEDOUT;
+			msdc_dma_stop();
+		}
+	}
+	ufs_wr(M_CFG, ufs_rd(M_CFG) | CFG_PIO);
+	if (!error && write) {
+		error = msdc_card_ready();
+	}
+	return error;
+}
