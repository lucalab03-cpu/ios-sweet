+/*
+ * DMA self-test: read the same 128 KiB with PIO and with DMA, compare, and log both speeds.
+ * Only the read path is exercised here; DMA stays off if anything differs.
+ */
+static uint8_t sw_dma_copy[131072];
+
+static void
+sweet_dma_selftest(void)
+{
+	const uint32_t nsec = sizeof(sw_dma_copy) / EMMC_SECTOR;
+	const uint32_t sector = (uint32_t)(su.first_block * (UFS_BLOCK / EMMC_SECTOR));
+	uint8_t *bounce = (uint8_t *)(su.dma + DMA_BOUNCE);
+	uint64_t t0, t1, t2, us_pio, us_dma;
+	int error;
+
+	t0 = mach_absolute_time();
+	error = emmc_read_sectors(sector, nsec);        /* su.use_dma is still false: PIO */
+	t1 = mach_absolute_time();
+	if (error) {
+		printf("SWEET EMMC: DMA self-test: PIO read failed (%d)\n", error);
+		return;
+	}
+	memcpy(sw_dma_copy, bounce, sizeof(sw_dma_copy));
+	memset(bounce, 0xa5, sizeof(sw_dma_copy));
+	flush_dcache64(su.dma_pa + DMA_BOUNCE, sizeof(sw_dma_copy), 1);
+	t2 = mach_absolute_time();
+	error = msdc_dma_xfer(sector, nsec, false);
+	uint64_t t3 = mach_absolute_time();
+	absolutetime_to_nanoseconds(t1 - t0, &us_pio);
+	absolutetime_to_nanoseconds(t3 - t2, &us_dma);
+	us_pio /= 1000;
+	us_dma /= 1000;
+	if (error) {
+		printf("SWEET EMMC: DMA self-test: DMA read failed (%d), staying on PIO\n", error);
+		return;
+	}
+	if (memcmp(sw_dma_copy, bounce, sizeof(sw_dma_copy)) != 0) {
+		printf("SWEET EMMC: DMA self-test: DATA MISMATCH, staying on PIO\n");
+		return;
+	}
+	su.use_dma = true;
+	printf("SWEET EMMC: DMA self-test OK: 128 KiB in %llu us (PIO) vs %llu us (DMA); DMA enabled\n",
+	    us_pio, us_dma);
+}
