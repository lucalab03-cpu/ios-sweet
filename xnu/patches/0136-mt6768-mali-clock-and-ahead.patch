-	wr(topckgen, CLK_CFG_1_CLR, 3u | (1u << 7));    /* mfg_sel's source and its gate */
-	wr(topckgen, CLK_CFG_1_SET, 2u);                /* syspll_d3 */
+	/*
+	 * 1: the clock. Until 0136 always syspll_d3 (364 MHz), whatever Android had set. Now (boot-arg sweetmaliclk,
+	 * default 1) mfg_sel stays on mfgpll when Android left it there and ungated: Android's gpufreq sets mfgpll and the
