+		gpu_clock_mhz = gpu_mhz();
+		printf("SWEET MALI: GPU clock %u MHz from Android's mfgpll (outside %u-%u): syspll_d3, now %u MHz\n", was,
+		    CLOCK_KEEP_MIN, CLOCK_KEEP_MAX, gpu_clock_mhz);
