+/*
+ * The GPU's clock (patch 0136), counted: its cycle counter (GPU_CYCLE_COUNT, started with GPU_COMMAND 5) over 20 ms
+ * of the system's clock. MHz, or 0 when the counter does not move.
+ */
+#define GPU_CYCLE_COUNT_LO  0x090u
+#define GPU_CYCLE_COUNT_HI  0x094u
+#define CLK_CFG_1           0x050u
+#define MFG_SEL_MFGPLL      1u
+#define MFG_SEL_SYSPLL_D3   2u
+#define MFG_SEL_GATE        (1u << 7)
+#define CLOCK_KEEP_MIN      400u            /* MHz: below this, syspll_d3's 364 is as good */
+#define CLOCK_KEEP_MAX      850u            /* MHz: this chip's working table ends at 823 (gpufreqv2, segment 3) */
+
+static uint64_t
+gpu_cycles(void)
+{
+	uint32_t hi, lo;
+
+	do {
+		hi = rd(mali, GPU_CYCLE_COUNT_HI);
+		lo = rd(mali, GPU_CYCLE_COUNT_LO);
+	} while (hi != rd(mali, GPU_CYCLE_COUNT_HI));
+	return ((uint64_t)hi << 32) | lo;
+}
+
+static unsigned
+gpu_mhz(void)
+{
+	uint64_t c0, c1, t0, t1, ns;
+
+	wr(mali, GPU_CMD, 5);                   /* CYCLE_COUNT_START */
+	mali_wait(1);
+	c0 = gpu_cycles();
+	t0 = mach_absolute_time();
+	mali_wait(20);
+	c1 = gpu_cycles();
+	t1 = mach_absolute_time();
+	wr(mali, GPU_CMD, 6);                   /* CYCLE_COUNT_STOP */
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	return ns != 0 && c1 > c0 ? (unsigned)((c1 - c0) * 1000 / ns) : 0;
+}
+
+static void
+mfg_sel_syspll_d3(void)
+{
+	wr(topckgen, CLK_CFG_1_CLR, 3u | MFG_SEL_GATE);  /* mfg_sel's source and its gate */
+	wr(topckgen, CLK_CFG_1_SET, MFG_SEL_SYSPLL_D3);
+}
