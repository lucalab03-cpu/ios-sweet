+/*
+ * Patch 0173: a whole physically contiguous run of a buffer into the GPU's tables, taking the lock once instead of once
+ * per 4 KB. A 6 MB buffer is 1536 pages: the lock alone was a large part of a CREATE_BO (2026-11-28, widget page: 7.1 ms
+ * a creation). The caller still calls sweet_mali_mapped() once when the buffer is in.
+ */
+bool
+sweet_mali_map_run(uint64_t gpu, uint64_t phys, uint64_t size)
+{
+	bool done = true;
+
+	lck_mtx_lock(&mali_lock);
+	for (uint64_t at = 0; at < size; at += 4096) {
+		if (!map_page(gpu + at, phys + at)) {
+			done = false;
+			break;
+		}
+	}
+	lck_mtx_unlock(&mali_lock);
+	return done;
+}
