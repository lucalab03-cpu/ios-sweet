+/*
+ * Patch 0173: when the imported pages are stored to memory around a SUBMIT -- boot-arg sweetmalistore, default 0.
+ * 0: once per group of SUBMITs, at the first one after the client waited for its chains. 1: before every SUBMIT, as
+ * every kernel did up to 0172.
+ */
+static uint32_t
+sweet_mali_store_each(void)
+{
+	static int each = -1;
+
+	if (each < 0 && !PE_parse_boot_argn("sweetmalistore", &each, sizeof(each))) {
+		each = 0;
+	}
+	return each != 0 ? 1 : 0;
+}
