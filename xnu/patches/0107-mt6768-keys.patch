+/* 16-bit PMIC register read through WACS2 (same sequence as pwrap_read16). */
+static int
+pmic_read(uint32_t adr, uint32_t *out)
+{
+	unsigned i;
+	uint32_t v = 0;
+
+	for (i = 0; i < 20000; i++) {
+		v = rd32(ks.pwrap, WACS2_RDATA);
+		if (WACS_FSM(v) == FSM_IDLE) {
+			break;
+		}
+		delay(1);
+	}
+	if (i == 20000) {
+		wr32(ks.pwrap, WACS2_VLDCLR, 1);
+		return ETIMEDOUT;
+	}
+	wr32(ks.pwrap, WACS2_CMD, (adr >> 1) << 16);
+	for (i = 0; i < 20000; i++) {
+		v = rd32(ks.pwrap, WACS2_RDATA);
+		if (WACS_FSM(v) == FSM_WFVLDCLR) {
+			break;
+		}
+		delay(1);
+	}
+	if (i == 20000) {
+		return ETIMEDOUT;
+	}
+	*out = v & 0xffffu;
+	wr32(ks.pwrap, WACS2_VLDCLR, 1);
+	return 0;
+}
+
+/* Hardware key n of the keypad: bit (n % 16) of KP_MEM(n / 16 + 1); 0 = pressed. */
+static bool
+kpd_down(const uint16_t mem[5], int key)
+{
+	if (key < 0 || key >= 72) {
+		return false;
+	}
+	return ((mem[key / 16] >> (key % 16)) & 1u) == 0;
+}
