+/*
+ * Patch 0137: a wait for the GPU that has lasted a second is logged, once per call, with who waits and on what
+ * (boot 2026-11-24 01:20: the app switcher froze backboardd's drawing; no chain was running or failing).
+ */
+static void
+sweet_mali_long_wait(const char * what, uint64_t since, uint32_t count, uint32_t unsubmitted, uint64_t fence)
+{
+	char name[32] = "";
+	uint64_t ns;
+
+	proc_selfname(name, sizeof(name));
+	absolutetime_to_nanoseconds(mach_absolute_time() - since, &ns);
+	IOLog("SweetMali: %s waits %llu ms in %s: %u object(s), %u never given a chain, e.g. fence %#llx (%s)\n", name,
+	    ns / 1000000, what, count, unsubmitted, fence,
+	    fence == 0 ? "none" : sweet_mali_fence_done(fence) ? "finished" : "not finished");
+}
