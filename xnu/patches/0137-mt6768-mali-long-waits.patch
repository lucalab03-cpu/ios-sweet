+/*
+ * Patch 0137: with queue_lock held, a chain at the head of its slot that has waited a second to start is logged once:
+ * what it waits for (boot 2026-11-24 01:20, the app switcher froze backboardd's drawing).
+ */
+static void
+report_stuck(void)
+{
+	uint64_t now = mach_absolute_time(), second;
+
+	nanoseconds_to_absolutetime(NSEC_PER_SEC, &second);
+	for (uint32_t s = 0; s < 2; s++) {
+		struct queue_slot *q = &slots[s];
+		struct queued_job *job = &q->jobs[q->head];
+
+		if (q->running || q->count == 0 || now - job->queued < second || q->stuckReported == job->seq) {
+			continue;
+		}
+		q->stuckReported = job->seq;
+		printf("SWEET MALI: chain %#llx (slot %u, #%llu) waits %llu ms to start: holds %u, reset wanted %d, other slot %s, "
+		    "%u dependencies, first %#llx (%s), finished: slot 0 #%llu, slot 1 #%llu\n", job->chain, s, job->seq,
+		    abs_to_us(now - job->queued) / 1000, queue_holds, queue_reset_wanted, slots[s ^ 1].running ? "running" : "idle",
+		    job->ndeps, job->ndeps ? job->deps[0] : 0ull, job->ndeps && fence_finished(job->deps[0]) ? "finished" : "not finished",
+		    slots[0].finished, slots[1].finished);
+	}
+}
+
