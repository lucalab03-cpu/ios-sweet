+/*
+ * 0154 (2026-11-26): surfaces around memory the caller already holds, which CoreAnimation's OpenGL ES renderer
+ * asks for (port of pixel3-ios's 0154, itself after HakiOS's MiniIOSurface methodWrapClientImage, APSL):
+ *  - selector 6, IOSurfaceWrapClientImage (gradients, glyph masks, layer contents): it fell into "accept and
+ *    ignore", so the caller got success and a zeroed reply -- a surface whose state page is at 0 -- and
+ *    backboardd died in memmove at address 0x30 three times in a row (round y, the first boot of CoreAnimation
+ *    on our OpenGL ES);
+ *  - a create whose properties carry IOSurfaceAddress (app icons), which got fresh zeroed memory.
+ * The surface's pixels are that memory itself, wired while the surface lives. Boot-arg sweetsurfwrap=0: selector
+ * 6 refused, IOSurfaceAddress ignored.
+ */
+static int sweet_surf_wrap_on = -1;
+static uint32_t
+sweet_surf_wrap_get(void)
+{
+	if (sweet_surf_wrap_on < 0) {
+		uint32_t v = 1;
+		PE_parse_boot_argn("sweetsurfwrap", &v, sizeof(v));
+		sweet_surf_wrap_on = v != 0;
+	}
+	return (uint32_t)sweet_surf_wrap_on;
+}
+#define sweet_surf_wrap sweet_surf_wrap_get()
+static uint32_t sweet_surf_wraps_logged;
+
+static IOReturn
+sweet_surface_wrap_range(SweetSurface *s, uint64_t address, uint32_t size, task_t task)
+{
+	IOMemoryDescriptor *md = NULL;
+	bool ro = false;
+
+	for (int attempt = 0; attempt < 2 && md == NULL; attempt++) {
+		ro = attempt == 1;
+		md = IOMemoryDescriptor::withAddressRange(address, size, ro ? kIODirectionOut : kIODirectionInOut, task);
+		if (md != NULL && md->prepare() != kIOReturnSuccess) {
+			OSSafeReleaseNULL(md);
+		}
+	}
+	if (md == NULL) {
+		IOLog("SWEET SURF: wrap: %u bytes at %#llx cannot be held\n", size, address);
+		return kIOReturnVMError;
+	}
+	s->memory = md;
+	s->wrapped = true;
+	s->mapCache = kIOMapDefaultCache | (ro ? kIOMapReadOnly : 0);
+	return kIOReturnSuccess;
+}
