+/*
+ * 0154: IOSurfaceWrapClientImage (selector 6). The request is 32 bytes in the caller's address space:
+ *     address (8), width, height, pixel format, bytes per element, bytes per row, size (4 each)
+ * The reply is a created surface's (returnSurface), so the caller's IOSurface has a real state page.
+ */
+IOReturn
+IOSurfaceRootUserClient::wrapClientImage(IOExternalMethodArguments *args)
+{
+	struct {
+		uint64_t address;
+		uint32_t width, height, format, bpe, bpr, size;
+	} r;
+
+	if (args->structureInput == NULL || args->structureInputSize < sizeof(r)) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(&r, args->structureInput, sizeof(r));
+	bool ok = r.address != 0 && r.size != 0 && r.size <= SWEET_SURFACE_MAX_ALLOC && r.width != 0 && r.height != 0 &&
+	    r.width <= SWEET_SURFACE_MAX_DIM && r.height <= SWEET_SURFACE_MAX_DIM && r.bpe != 0 && r.bpe <= 64 &&
+	    r.bpr >= r.width * r.bpe &&
+	    (uint64_t)r.size >= (uint64_t)r.bpr * (r.height - 1) + (uint64_t)r.width * r.bpe;   /* (a mask's last row may end early) */
+	if (sweet_surf_wraps_logged < 8 || !ok) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		sweet_surf_wraps_logged++;
+		IOLog("SWEET SURF: %s wrap client image at %#llx: %ux%u fmt %#x bpe %u bpr %u size %u%s\n", name,
+		    r.address, r.width, r.height, r.format, r.bpe, r.bpr, r.size, ok ? "" : ": refused (bad request)");
+	}
+	if (!ok) {
+		return kIOReturnBadArgument;
+	}
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return kIOReturnNoMemory;
+	}
+	s->width = r.width;
+	s->height = r.height;
+	s->pixelFormat = r.format;
+	s->bytesPerElement = (uint16_t)r.bpe;
+	s->bytesPerRow = r.bpr;
+	s->elementWidth = s->elementHeight = 1;
+	s->allocSize = r.size;
+	IOReturn ret = sweet_surface_wrap_range(s, r.address, r.size, fTask);
+	if (ret != kIOReturnSuccess) {
+		s->release();
+		return ret;
+	}
+	if (!sweet_surface_publish(s)) {
+		s->release();
+		return kIOReturnNoResources;
+	}
+	ret = returnSurface(s, args);   /* takes the caller's user count, as create */
+	s->release();
+	return ret;
+}
