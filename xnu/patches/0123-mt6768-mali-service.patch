+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
+ * What the SweetMali service uses (iokit/Kernel/arm/SweetMali.cpp)
+ * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+#define MMU_INT_RAWSTAT     0x2000u
+#define MMU_INT_CLEAR       0x2004u
+#define JS0                 0x1800u         /* fragment jobs; everything else goes to slot 1 */
+#define GPU_ADDRESS_FIRST   0x01000000ull
+#define GPU_ADDRESS_END     (1ull << 35)
+
+static LCK_GRP_DECLARE(mali_lock_group, "sweet.mali");
+/* The page tables and the address counter. */
+static LCK_MTX_DECLARE(mali_lock, &mali_lock_group);
+/* Held while a job runs and while the address space is rewritten; taken before mali_lock, never after. */
+static LCK_MTX_DECLARE(mali_job_lock, &mali_lock_group);
+static uint64_t next_address = GPU_ADDRESS_FIRST;
+
+bool
+sweet_mali_ready(void)
+{
+	return reached >= 6;
+}
+
+/* Linux's DRM_PANFROST_PARAM_*, in its order, from the registers they come from. */
+bool
+sweet_mali_parameter(uint32_t which, uint64_t *value)
+{
+	static const uint16_t simple[] = {
+		[5] = 0xe00,                    /* STACK_PRESENT: none on Bifrost, reads 0 */
+		[6] = 0x018, [7] = 0x01c, [8] = 0x004, [9] = 0x008, [10] = 0x00c, [11] = 0x010, [12] = 0x014,
+		[13] = 0x0ac, [14] = 0x0a0, [15] = 0x0a4, [16] = 0x0a8, [17] = 0x300,
+		[18] = 0x0b0, [19] = 0x0b4, [20] = 0x0b8, [21] = 0x0bc,
+	};
+
+	if (!sweet_mali_ready()) {
+		return false;
+	}
+	switch (which) {
+	case 0:
+		*value = gpu_id >> 16;
+		return true;
+	case 1:
+		*value = gpu_id & 0xffff;
+		return true;
+	case 2:
+	case 3:
+	case 4:
+		*value = rd(mali, 0x100 + (which - 2) * 0x10) | ((uint64_t)rd(mali, 0x104 + (which - 2) * 0x10) << 32);
+		return true;
+	case 38:                                /* NR_CORE_GROUPS */
+		*value = 1;
+		return true;
+	case 39:                                /* THREAD_TLS_ALLOC: never less than THREAD_MAX_THREADS, or spilling shaders write past their stack */
+		*value = rd(mali, 0x310);
+		if (*value < rd(mali, 0x0a0)) {
+			*value = rd(mali, 0x0a0);
+		}
+		return true;
+	case 40:                                /* AFBC_FEATURES: none on this GPU */
+		*value = 0;
+		return true;
+	case 41:                                /* SYSTEM_TIMESTAMP */
+		*value = rd(mali, 0x098) | ((uint64_t)rd(mali, 0x09c) << 32);
+		return true;
+	case 42:                                /* SYSTEM_TIMESTAMP_FREQUENCY: the SoC's counter */
+		*value = 26000000;
+		return true;
+	case 43:                                /* ALLOWED_JM_CTX_PRIORITIES: medium */
+		*value = 1u << 1;
+		return true;
+	case 44:                                /* SELECTED_COHERENCY: none */
+		*value = 31;
+		return true;
+	default:
+		if (which >= 22 && which <= 37) {
+			*value = rd(mali, 0x0c0 + (which - 22) * 4);
+			return true;
+		}
+		if (which < sizeof(simple) / sizeof(simple[0]) && simple[which] != 0) {
+			*value = rd(mali, simple[which]);
+			return true;
+		}
+		return false;
+	}
+}
+
+/* `size` bytes of GPU addresses, never given out twice (there are 32 GB), 64 KB apart. 0: none left. */
+uint64_t
+sweet_mali_address(uint64_t size)
+{
+	uint64_t address;
+
+	lck_mtx_lock(&mali_lock);
+	address = next_address;
+	if (address + size > GPU_ADDRESS_END) {
+		address = 0;
+	} else {
+		next_address += (size + 0xffff) & ~0xffffull;
+	}
+	lck_mtx_unlock(&mali_lock);
+	return address;
+}
+
+/* One 4 KB page of physical memory into the GPU's tables. */
+bool
+sweet_mali_map(uint64_t gpu, uint64_t phys)
+{
+	bool done;
+
+	lck_mtx_lock(&mali_lock);
+	done = map_page(gpu, phys);
+	lck_mtx_unlock(&mali_lock);
+	return done;
+}
+
+/* After entries were added: the MMU forgets what it remembered. The address space is set up again from the top. */
+void
+sweet_mali_mapped(void)
+{
+	lck_mtx_lock(&mali_job_lock);
+	lck_mtx_lock(&mali_lock);
+	as0_update(pt_top_phys, TRANSCFG_AARCH64_4K);
+	lck_mtx_unlock(&mali_lock);
+	lck_mtx_unlock(&mali_job_lock);
+}
+
+void
+sweet_mali_unmap(uint64_t gpu, uint64_t size)
+{
+	lck_mtx_lock(&mali_lock);
+	for (uint64_t at = gpu; at < gpu + size; at += 4096) {
+		uint64_t *entry = &pt_top[(at >> 30) & 31];
+
+		if (!(*entry & 1)) {
+			continue;
+		}
+		entry = &((uint64_t *)phystokv(*entry & PTE_ADDRESS))[(at >> 21) & 511];
+		if (!(*entry & 1)) {
+			continue;
+		}
+		entry = &((uint64_t *)phystokv(*entry & PTE_ADDRESS))[(at >> 12) & 511];
+		*entry = 0;
+		FlushPoC_DcacheRegion((vm_offset_t)entry, sizeof(*entry));
+	}
+	lck_mtx_unlock(&mali_lock);
+	sweet_mali_mapped();                    /* an entry taken out: the TLB may hold it */
+}
+
+/* What a program wrote to memory the GPU reads: out of the processor's caches. */
+void
+sweet_mali_to_memory(const void *start, uint64_t size)
+{
+	if (start != NULL && size != 0) {
+		FlushPoC_DcacheRegion((vm_offset_t)start, (size_t)size);
+	}
+}
+
+/* Until the job slot has finished or failed: a moment of polling, then asleep 200 us at a time. */
+static bool
+wait_job(uint32_t mask, uint32_t want, uint32_t ms)
+{
+	uint64_t deadline;
+
+	for (int i = 0; i < 20; i++) {
+		if ((rd(mali, JOB_INT_RAWSTAT) & mask) == want) {
+			return true;
+		}
+		delay(10);
+	}
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	while (mach_absolute_time() < deadline) {
+		uint64_t nap;
+
+		if ((rd(mali, JOB_INT_RAWSTAT) & mask) == want) {
+			return true;
+		}
+		clock_interval_to_deadline(200, NSEC_PER_USEC, &nap);
+		(void)assert_wait_deadline(&mali_sleep_chan, THREAD_UNINT, nap);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+	return (rd(mali, JOB_INT_RAWSTAT) & mask) == want;
+}
+
+/*
+ * One job chain, from GPU address `chain`, run to its end before this returns: fragment jobs on slot 0,
+ * the rest on slot 1. 0 when it finished; otherwise the slot's status (a fault) or 0xff for no answer
+ * within a second -- and then the GPU is reset and brought back, so that the next job finds it working.
+ */
+uint32_t
+sweet_mali_submit(uint64_t chain, bool fragment)
+{
+	uint32_t slot = fragment ? 0 : 1, js = fragment ? JS0 : JS1, status = 0;
+	uint32_t done_bits = (1u << slot) | (1u << (slot + 16));
+
+	lck_mtx_lock(&mali_job_lock);
+	wr(mali, JOB_INT_CLEAR, done_bits);
+	wr(mali, js + JS_HEAD_NEXT_LO, (uint32_t)chain);
+	wr(mali, js + JS_HEAD_NEXT_HI, (uint32_t)(chain >> 32));
+	wr(mali, js + JS_AFFINITY_NEXT_LO, shader_mask);
+	wr(mali, js + JS_AFFINITY_NEXT_HI, 0);
+	wr(mali, js + JS_CONFIG_NEXT, JS_CONFIG);
+	wr(mali, js + JS_COMMAND_NEXT, 1);
+	if (!wait_job(done_bits, 1u << slot, 1000)) {
+		uint32_t raw = rd(mali, JOB_INT_RAWSTAT);
+		uint64_t fault = rd(mali, AS0 + 0x20) | ((uint64_t)rd(mali, AS0 + 0x24) << 32);
+
+		status = (raw & (1u << (slot + 16))) ? rd(mali, js + JS_STATUS) : 0xff;
+		printf("SWEET MALI: a job on slot %u did not finish: job irq %#x, status %#x, MMU irq %#x, fault %#x at %#llx\n",
+		    slot, raw, rd(mali, js + JS_STATUS), rd(mali, MMU_INT_RAWSTAT), rd(mali, AS0 + AS_FAULTSTATUS), (unsigned long long)fault);
+		wr(mali, GPU_INT_CLEAR, 0xffffffffu);
+		wr(mali, GPU_CMD, CMD_SOFT_RESET);
+		(void)wait_for(mali, GPU_INT_RAWSTAT, IRQ_RESET_COMPLETED, IRQ_RESET_COMPLETED, 100);
+		wr(mali, L2_PWRON, rd(mali, L2_PRESENT));
+		wr(mali, TILER_PWRON, rd(mali, TILER_PRESENT));
+		wr(mali, SHADER_PWRON, shader_mask);
+		(void)wait_for(mali, SHADER_READY, shader_mask, shader_mask, 50);
+		lck_mtx_lock(&mali_lock);
+		as0_update(pt_top_phys, TRANSCFG_AARCH64_4K);
+		lck_mtx_unlock(&mali_lock);
+		wr(mali, MMU_INT_CLEAR, 0xffffffffu);
+	}
+	wr(mali, JOB_INT_CLEAR, done_bits);
+	lck_mtx_unlock(&mali_job_lock);
+	return status;
+}
+
 static void
 mali_up(int mode)
 {
@@ -410,6 +645,9 @@ mali_up(int mode)
 		break;
 	}
 	printf("SWEET MALI: came up to step %u of 6\n", reached);
+	if (mode >= 3 && reached == 6) {
+		SweetMaliStart();
+	}
 }
 
