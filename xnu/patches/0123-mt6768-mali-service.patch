diff --git a/iokit/Kernel/arm/SweetMali.cpp b/iokit/Kernel/arm/SweetMali.cpp
new file mode 100644
index 0000000..6d34239
--- /dev/null
+++ b/iokit/Kernel/arm/SweetMali.cpp
@@ -0,0 +1,482 @@
+/*
+ * SweetMali: the Mali-G52 of the Moto G05 for programs to draw with.
+ *
+ * bsd/dev/sweet_mali.c brings the GPU up (boot-arg sweetmali=3) and, once a job has run through its
+ * page tables, starts this service. A program that opens it speaks the interface of Linux's panfrost
+ * DRM driver, the one Mesa's panfrost knows: every request is a call of the user client with the
+ * request's number as the selector and its structure passed in and back. What Linux does with mmap()
+ * on the device is the client memory of the type that is the buffer's handle.
+ *
+ * The design and the request numbers follow the HakiOS projects (RedwoodMali of hakios-a32 and
+ * hakios-mt6768; Apple Public Source License 2.0, as this file is), reduced to what a first program
+ * needs: parameters, buffers (made, entered into the GPU's address space, told their address, mapped,
+ * given back) and job chains. A buffer is wired kernel memory, zero when made and mapped uncached, so
+ * what the program writes goes to memory where the GPU reads it. A job chain is run to its end before
+ * the call returns, so waiting for a buffer has nothing left to wait for, and the synchronisation
+ * objects Mesa asks about are always signalled. Not here yet: jobs that overlap or are queued, an
+ * address space for each program, interrupts, buffers shared between programs, IOSurfaces as buffers.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <device/device_types.h> /* io_buf_ptr_t for private OSKext headers */
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <mach/vm_param.h>
+#include <sys/systm.h>
+
+extern "C" {
+/* bsd/dev/sweet_mali.c */
+bool sweet_mali_ready(void);
+bool sweet_mali_parameter(uint32_t which, uint64_t * value);
+uint64_t sweet_mali_address(uint64_t size);
+bool sweet_mali_map(uint64_t gpu, uint64_t phys);
+void sweet_mali_mapped(void);
+void sweet_mali_unmap(uint64_t gpu, uint64_t size);
+void sweet_mali_to_memory(const void * start, uint64_t size);
+uint32_t sweet_mali_submit(uint64_t chain, bool fragment);
+void SweetMaliStart(void);
+}
+
+/* Linux's include/uapi/drm/panfrost_drm.h and drm.h: the requests' numbers and structures. */
+enum {
+	kDrmGemClose            = 0x09,
+	kPanfrostSubmit         = 0x40,
+	kPanfrostWaitBO         = 0x41,
+	kPanfrostCreateBO       = 0x42,
+	kPanfrostMmapBO         = 0x43,
+	kPanfrostGetParam       = 0x44,
+	kPanfrostGetBOOffset    = 0x45,
+	kPanfrostMadvise        = 0x48,
+	kPanfrostSetLabelBO     = 0x49,
+	kDrmSyncobjCreate       = 0xbf,         /* Linux's drm_syncobj.h: what Mesa's panfrost waits with */
+	kDrmSyncobjDestroy      = 0xc0,
+	kDrmSyncobjWait         = 0xc3,
+	kDrmSyncobjReset        = 0xc4,
+	kDrmSyncobjSignal       = 0xc5,
+};
+
+struct sweet_drm_gem_close {
+	uint32_t handle, pad;
+};
+struct sweet_panfrost_submit {
+	uint64_t jc;
+	uint64_t in_syncs;
+	uint32_t in_sync_count;
+	uint32_t out_sync;
+	uint64_t bo_handles;
+	uint32_t bo_handle_count;
+	uint32_t requirements;
+	uint32_t jm_ctx_handle, pad;            /* newer than Mesa 25.0.7, which sends 48 bytes */
+};
+#define SWEET_PANFROST_JD_REQ_FS (1u << 0)
+struct sweet_panfrost_wait_bo {
+	uint32_t handle, pad;
+	int64_t timeout_ns;
+};
+struct sweet_panfrost_create_bo {
+	uint32_t size, flags, handle, pad;
+	uint64_t offset;
+};
+struct sweet_panfrost_mmap_bo {
+	uint32_t handle, flags;
+	uint64_t offset;
+};
+struct sweet_panfrost_get_param {
+	uint32_t param, pad;
+	uint64_t value;
+};
+struct sweet_panfrost_get_bo_offset {
+	uint32_t handle, pad;
+	uint64_t offset;
+};
+struct sweet_panfrost_madvise {
+	uint32_t handle, madv, retained;
+};
+struct sweet_syncobj_create {
+	uint32_t handle, flags;
+};
+
+#define SWEET_MALI_BUFFERS      4096
+#define SWEET_MALI_BUFFER_MAX   (256ull << 20)
+#define SWEET_MALI_SYNCOBJS     1024
+
+struct sweet_mali_buffer {
+	IOBufferMemoryDescriptor * memory;
+	uint64_t address, size;
+};
+
+static IOLock * gSweetMaliLock;
+
+class SweetMali : public IOService
+{
+	OSDeclareDefaultStructors(SweetMali);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetMali, IOService);
+
+bool
+SweetMali::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "SweetMaliUserClient");
+	setName("SweetMali");
+	registerService();
+	return true;
+}
+
+void
+SweetMaliStart(void)
+{
+	IOService * provider = IOService::getPlatform();
+	SweetMali * gpu;
+
+	gSweetMaliLock = IOLockAlloc();
+	gpu = OSTypeAlloc(SweetMali);
+	if (gpu == NULL || provider == NULL || gSweetMaliLock == NULL || !gpu->init() || !gpu->attach(provider)) {
+		OSSafeReleaseNULL(gpu);
+		IOLog("SweetMali: cannot create the service\n");
+		return;
+	}
+	if (!gpu->start(provider)) {
+		gpu->detach(provider);
+		IOLog("SweetMali: the service did not start\n");
+	} else {
+		IOLog("SweetMali: the GPU is there for programs to draw with\n");
+	}
+	gpu->release();
+}
+
+class SweetMaliUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(SweetMaliUserClient);
+
+	struct sweet_mali_buffer * fBuffers;    /* handle n is fBuffers[n - 1] */
+	uint8_t *                  fSyncobjs;   /* syncobj n is in use when fSyncobjs[n - 1] is */
+	uint32_t                   fNextBuffer;
+	uint32_t                   fSubmits, fFailed, fRequests;
+
+	struct sweet_mali_buffer * buffer(uint32_t handle);
+	void freeBuffer(struct sweet_mali_buffer * b);
+	IOReturn createBO(struct sweet_panfrost_create_bo * request);
+	IOReturn submit(struct sweet_panfrost_submit * request);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual void free(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+	    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(SweetMaliUserClient, IOUserClient);
+
+bool
+SweetMaliUserClient::start(IOService * provider)
+{
+	if (!sweet_mali_ready() || !IOUserClient::start(provider)) {
+		IOLog("SweetMali: a client could not be started\n");
+		return false;
+	}
+	IOLog("SweetMali: a client opened the GPU\n");
+	fBuffers = IONewZeroData(struct sweet_mali_buffer, SWEET_MALI_BUFFERS);
+	fSyncobjs = IONewZeroData(uint8_t, SWEET_MALI_SYNCOBJS);
+	return fBuffers != NULL && fSyncobjs != NULL;
+}
+
+struct sweet_mali_buffer *
+SweetMaliUserClient::buffer(uint32_t handle)
+{
+	if (handle == 0 || handle > SWEET_MALI_BUFFERS || fBuffers == NULL || fBuffers[handle - 1].memory == NULL) {
+		return NULL;
+	}
+	return &fBuffers[handle - 1];
+}
+
+/* With the lock held. Every job has finished before its call returned, so none can still be using it. */
+void
+SweetMaliUserClient::freeBuffer(struct sweet_mali_buffer * b)
+{
+	sweet_mali_unmap(b->address, b->size);
+	b->memory->release();
+	bzero(b, sizeof(*b));
+}
+
+/* With the lock held. */
+IOReturn
+SweetMaliUserClient::createBO(struct sweet_panfrost_create_bo * request)
+{
+	uint64_t size = round_page_64(request->size);
+	IOBufferMemoryDescriptor * memory;
+	struct sweet_mali_buffer * b = NULL;
+	bool mapped = true;
+
+	if (size == 0 || size > SWEET_MALI_BUFFER_MAX) {
+		return kIOReturnBadArgument;
+	}
+	for (uint32_t n = 0; n < SWEET_MALI_BUFFERS; n++) {
+		uint32_t i = (fNextBuffer + n) % SWEET_MALI_BUFFERS;
+
+		if (fBuffers[i].memory == NULL) {
+			b = &fBuffers[i];
+			request->handle = i + 1;
+			fNextBuffer = i + 1;
+			break;
+		}
+	}
+	if (b == NULL) {
+		IOLog("SweetMali: no handles left\n");
+		return kIOReturnNoResources;
+	}
+	memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut | kIOMemoryKernelUserShared |
+	    kIOMapWriteCombineCache, (vm_size_t) size, PAGE_SIZE);
+	if (memory == NULL) {
+		IOLog("SweetMali: no memory for a buffer of %llu bytes\n", size);
+		return kIOReturnNoMemory;
+	}
+	b->address = sweet_mali_address(size);
+	/* every 4 KB of it: the GPU's pages, a quarter of the kernel's 16 KB ones */
+	for (uint64_t offset = 0; offset < size && mapped && b->address != 0; offset += 4096) {
+		IOByteCount length = 0;
+		addr64_t phys = memory->getPhysicalSegment(offset, &length, kIOMemoryMapperNone);
+
+		mapped = phys != 0 && sweet_mali_map(b->address + offset, phys);
+	}
+	if (b->address == 0 || !mapped) {
+		if (b->address != 0) {
+			sweet_mali_unmap(b->address, size);
+		}
+		bzero(b, sizeof(*b));
+		memory->release();
+		IOLog("SweetMali: a buffer of %llu bytes cannot be entered into the GPU's address space\n", size);
+		return kIOReturnNoMemory;
+	}
+	sweet_mali_mapped();
+	b->memory = memory;
+	b->size = size;
+	request->offset = b->address;
+	return kIOReturnSuccess;
+}
+
+/*
+ * SUBMIT: what the program wrote through its own mapping goes to memory where the GPU reads it (small
+ * buffers only: the big ones a job names are the driver's pools and the tiler heap, written and read
+ * on the GPU's side), then the chain is run to its end.
+ */
+IOReturn
+SweetMaliUserClient::submit(struct sweet_panfrost_submit * request)
+{
+	uint32_t * handles = NULL;
+	uint32_t count = request->bo_handle_count;
+	IOReturn ret = kIOReturnSuccess;
+	uint32_t status;
+
+	if (request->jc == 0 || count > SWEET_MALI_BUFFERS) {
+		return kIOReturnBadArgument;
+	}
+	if (count != 0) {
+		handles = IONewData(uint32_t, count);
+		if (handles == NULL) {
+			return kIOReturnNoMemory;
+		}
+		if (copyin((user_addr_t) request->bo_handles, handles, count * sizeof(uint32_t)) != 0) {
+			IOFreeData(handles, count * sizeof(uint32_t));
+			return kIOReturnVMError;
+		}
+	}
+	fSubmits++;
+	for (uint32_t i = 0; i < count; i++) {
+		struct sweet_mali_buffer * b = buffer(handles[i]);
+
+		if (b != NULL && b->memory->getBytesNoCopy() != NULL && b->size <= (1ull << 20)) {
+			sweet_mali_to_memory(b->memory->getBytesNoCopy(), b->size);
+		}
+	}
+	status = sweet_mali_submit(request->jc, (request->requirements & SWEET_PANFROST_JD_REQ_FS) != 0);
+	if (status != 0) {
+		fFailed++;
+		IOLog("SweetMali: job chain %#llx did not finish (status %#x)\n", request->jc, status);
+		ret = kIOReturnIOError;
+	}
+	/* the GPU wrote to the buffers: the processor must not see what it had cached of them */
+	for (uint32_t i = 0; i < count; i++) {
+		struct sweet_mali_buffer * b = buffer(handles[i]);
+
+		if (b != NULL && b->memory->getBytesNoCopy() != NULL && b->size <= (1ull << 20)) {
+			sweet_mali_to_memory(b->memory->getBytesNoCopy(), b->size);
+		}
+	}
+	if (handles != NULL) {
+		IOFreeData(handles, count * sizeof(uint32_t));
+	}
+	return ret;
+}
+
+IOReturn
+SweetMaliUserClient::clientClose(void)
+{
+	IOLockLock(gSweetMaliLock);
+	for (uint32_t i = 0; fBuffers != NULL && i < SWEET_MALI_BUFFERS; i++) {
+		if (fBuffers[i].memory != NULL) {
+			freeBuffer(&fBuffers[i]);
+		}
+	}
+	IOLockUnlock(gSweetMaliLock);
+	if (fSubmits != 0) {
+		IOLog("SweetMali: a client goes after %u job chains, %u of them unfinished\n", fSubmits, fFailed);
+	}
+	terminate();
+	return kIOReturnSuccess;
+}
+
+void
+SweetMaliUserClient::free(void)
+{
+	if (fBuffers != NULL) {
+		IOFreeData(fBuffers, SWEET_MALI_BUFFERS * sizeof(struct sweet_mali_buffer));
+		fBuffers = NULL;
+	}
+	if (fSyncobjs != NULL) {
+		IOFreeData(fSyncobjs, SWEET_MALI_SYNCOBJS);
+		fSyncobjs = NULL;
+	}
+	IOUserClient::free();
+}
+
+IOReturn
+SweetMaliUserClient::clientMemoryForType(UInt32 type, IOOptionBits * options, IOMemoryDescriptor ** memory)
+{
+	struct sweet_mali_buffer * b;
+	IOReturn ret = kIOReturnBadArgument;
+
+	IOLockLock(gSweetMaliLock);
+	b = buffer(type);
+	if (b != NULL) {
+		b->memory->retain();
+		*memory = b->memory;
+		*options = kIOMapInhibitCache;
+		ret = kIOReturnSuccess;
+	}
+	IOLockUnlock(gSweetMaliLock);
+	return ret;
+}
+
+IOReturn
+SweetMaliUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	union {
+		struct sweet_drm_gem_close close;
+		struct sweet_panfrost_submit submit;
+		struct sweet_panfrost_wait_bo wait;
+		struct sweet_panfrost_create_bo create;
+		struct sweet_panfrost_mmap_bo mmap;
+		struct sweet_panfrost_get_param param;
+		struct sweet_panfrost_get_bo_offset offset;
+		struct sweet_panfrost_madvise madvise;
+		struct sweet_syncobj_create syncCreate;
+		uint8_t raw[64];
+	} r;
+	size_t size = args->structureInputSize;
+	struct sweet_mali_buffer * b;
+	IOReturn ret = kIOReturnSuccess;
+
+	if (args->structureInput == NULL || size > sizeof(r) || fBuffers == NULL) {
+		return kIOReturnBadArgument;
+	}
+	if (!sweet_mali_ready()) {
+		return kIOReturnNotReady;
+	}
+	bzero(&r, sizeof(r));
+	memcpy(&r, args->structureInput, size);
+
+	IOLockLock(gSweetMaliLock);
+	if (fRequests++ < 32) {                 /* the first ones a client makes, for following it from the log */
+		IOLog("SweetMali: request %#x, %zu bytes\n", selector, size);
+	}
+	switch (selector) {
+	case kPanfrostGetParam:
+		if (!sweet_mali_parameter(r.param.param, &r.param.value)) {
+			ret = kIOReturnBadArgument;
+		}
+		break;
+	case kPanfrostCreateBO:
+		ret = createBO(&r.create);
+		break;
+	case kPanfrostMmapBO:                   /* the offset is the handle: the program maps client memory of that type */
+		ret = buffer(r.mmap.handle) != NULL ? kIOReturnSuccess : kIOReturnNotFound;
+		r.mmap.offset = (uint64_t) r.mmap.handle << 12;
+		break;
+	case kPanfrostGetBOOffset:
+		b = buffer(r.offset.handle);
+		ret = b != NULL ? kIOReturnSuccess : kIOReturnNotFound;
+		r.offset.offset = b != NULL ? b->address : 0;
+		break;
+	case kPanfrostSubmit:
+		ret = submit(&r.submit);
+		break;
+	case kPanfrostWaitBO:                   /* every job is finished when its call returns */
+		ret = buffer(r.wait.handle) != NULL ? kIOReturnSuccess : kIOReturnNotFound;
+		break;
+	case kPanfrostSetLabelBO:               /* a label is for the driver's debug output: kept nowhere */
+		break;
+	case kPanfrostMadvise:
+		r.madvise.retained = 1;
+		break;
+	case kDrmGemClose:
+		b = buffer(r.close.handle);
+		if (b != NULL) {
+			freeBuffer(b);
+		} else {
+			ret = kIOReturnNotFound;
+		}
+		break;
+	case kDrmSyncobjCreate:
+		ret = kIOReturnNoResources;
+		for (uint32_t i = 0; i < SWEET_MALI_SYNCOBJS; i++) {
+			if (!fSyncobjs[i]) {
+				fSyncobjs[i] = 1;
+				r.syncCreate.handle = i + 1;
+				ret = kIOReturnSuccess;
+				break;
+			}
+		}
+		break;
+	case kDrmSyncobjDestroy: {
+		uint32_t handle = r.syncCreate.handle;
+
+		if (handle != 0 && handle <= SWEET_MALI_SYNCOBJS) {
+			fSyncobjs[handle - 1] = 0;
+		} else {
+			ret = kIOReturnBadArgument;
+		}
+		break;
+	}
+	case kDrmSyncobjWait:                   /* nothing is ever pending */
+	case kDrmSyncobjReset:
+	case kDrmSyncobjSignal:
+		break;
+	default:
+		IOLog("SweetMali: request %#x (%zu bytes) is not known here\n", selector, size);
+		ret = kIOReturnUnsupported;
+		break;
+	}
+	IOLockUnlock(gSweetMaliLock);
+
+	if (args->structureOutput != NULL && args->structureOutputSize >= size) {
+		memcpy(args->structureOutput, &r, size);
+		args->structureOutputSize = (uint32_t) size;
+	}
+	return ret;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
