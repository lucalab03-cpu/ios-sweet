+/* Patch 0141: the presenter thread. */
+void
+AppleCLCD::presenterThread(void *arg, wait_result_t wr)
+{
+	(void)wr;
+	((AppleCLCD *)arg)->presenterLoop();
+}
+
+void
+AppleCLCD::presenterLoop(void)
+{
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+
+	if (rec == NULL) {
+		return;
+	}
+	IOLockLock(fLock);
+	for (;;) {
+		while (!fDirty || fPowerOff) {
+			IOLockSleep(fLock, &fPendingGPU, THREAD_UNINT);
+		}
+		uint64_t gpu[2] = { fPendingGPU[0], fPendingGPU[1] };
+		IOLockUnlock(fLock);
+
+		uint64_t t0 = mach_absolute_time(), deadline, ns;
+		if (!sweet_mali_fence_done(gpu[0]) || !sweet_mali_fence_done(gpu[1])) {
+			clock_interval_to_deadline(100, kMillisecondScale, &deadline);
+			(void)sweet_mali_fences_wait(gpu, 2, true, deadline, NULL);
+		}
+		uint64_t t1 = mach_absolute_time();
+
+		IOLockLock(fPresentLock);
+		IOLockLock(fLock);
+		bool newer = fPendingGPU[0] != gpu[0] || fPendingGPU[1] != gpu[1];
+		if (newer && (!sweet_mali_fence_done(fPendingGPU[0]) || !sweet_mali_fence_done(fPendingGPU[1]))) {
+			/* a newer frame came while this one waited, and is not drawn yet: wait for it instead */
+			fStatDropped++;
+			IOLockUnlock(fPresentLock);
+			continue;
+		}
+		memcpy(rec, fPending, SWEET_FB_SWAP_REC_SIZE);
+		fDirty = false;
+		IOLockUnlock(fLock);
+		present(rec);
+		IOLockUnlock(fPresentLock);
+		uint64_t t2 = mach_absolute_time();
+
+		absolutetime_to_nanoseconds(t1 - t0, &ns);
+		fStatWaitUs += ns / 1000;
+		absolutetime_to_nanoseconds(t2 - t1, &ns);
+		fStatCopyUs += ns / 1000;
+		if (ns / 1000 > fStatCopyMax) {
+			fStatCopyMax = ns / 1000;
+		}
+		fStatCopies++;
+		IOLockLock(fLock);
+	}
+}
+
+/* Every 10 s with swaps: what the presenter did (0141). With fLock held. */
+void
+AppleCLCD::stats(void)
+{
+	uint64_t now = mach_absolute_time(), ns;
+
+	if (fStatT0 == 0) {
+		fStatT0 = now;
+		return;
+	}
+	absolutetime_to_nanoseconds(now - fStatT0, &ns);
+	if (ns < 10ull * NSEC_PER_SEC) {
+		return;
+	}
+	IOLog("SWEET FB: in %llu ms: %llu swaps, %llu frames shown (%llu replaced by a newer one), copy %llu us average "
+	    "%llu longest, GPU wait %llu us average\n", ns / 1000000, fStatSwaps, fStatCopies, fStatDropped,
+	    fStatCopies ? fStatCopyUs / fStatCopies : 0, fStatCopyMax, fStatCopies ? fStatWaitUs / fStatCopies : 0);
+	fStatT0 = now;
+	fStatSwaps = fStatCopies = fStatDropped = fStatCopyUs = fStatCopyMax = fStatWaitUs = 0;
+}
