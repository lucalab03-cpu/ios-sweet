+static uint32_t sweet_fb_xmap[2048];
+
+/* Nearest-neighbour blit of a logical-display rectangle onto the panel. */
+void
+AppleCLCD::scaled_blit(SweetSurface *s, uintptr_t src, uint32_t bpe,
+    int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	int32_t LW = (int32_t)fLogicalW, LH = (int32_t)fLogicalH;
+	if (src == 0 || bpe != 4 || s->elementWidth != 1 || s->elementHeight != 1 || s->memory == NULL) {
+		return;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > LW - dx) {
+		w = LW - dx;
+	}
+	if (h > LH - dy) {
+		h = LH - dy;
+	}
+	if (w <= 0 || h <= 0) {
+		return;
+	}
+	uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow + (uint64_t)(sx + w) * 4;
+	if (last > s->memory->getLength()) {
+		return;
+	}
+	int64_t PW = fWidth, PH = fHeight;
+	int32_t X0 = (int32_t)((int64_t)dx * PW / LW);
+	int32_t X1 = (int32_t)(((int64_t)(dx + w) * PW + LW - 1) / LW);
+	int32_t Y0 = (int32_t)((int64_t)dy * PH / LH);
+	int32_t Y1 = (int32_t)(((int64_t)(dy + h) * PH + LH - 1) / LH);
+	if (X1 > (int32_t)fWidth) {
+		X1 = (int32_t)fWidth;
+	}
+	if (Y1 > (int32_t)fHeight) {
+		Y1 = (int32_t)fHeight;
+	}
+	for (int32_t X = X0; X < X1; X++) {
+		int32_t i = (int32_t)(((int64_t)(2 * X + 1) * LW) / (2 * PW)) - dx;
+		i = i < 0 ? 0 : (i > w - 1 ? w - 1 : i);
+		sweet_fb_xmap[X - X0] = (uint32_t)(sx + i);
+	}
+	for (int32_t Y = Y0; Y < Y1; Y++) {
+		int32_t j = (int32_t)(((int64_t)(2 * Y + 1) * LH) / (2 * PH)) - dy;
+		j = j < 0 ? 0 : (j > h - 1 ? h - 1 : j);
+		const uint32_t *srow = (const uint32_t *)(src + s->offset + (uint64_t)(sy + j) * s->bytesPerRow);
+		uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)Y * fRowBytes);
+		for (int32_t X = X0; X < X1; X++) {
+			drow[X] = srow[sweet_fb_xmap[X - X0]];
+		}
+	}
+}
