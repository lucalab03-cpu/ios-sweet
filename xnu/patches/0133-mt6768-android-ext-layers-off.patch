diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 96ca431..1058ae0 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -104,6 +104,28 @@ sweet_ovl_layers(uint64_t fbPhys, uint64_t fbSize)
 				keep &= ~(1u << n);
 			}
 		}
+		/*
+		 * Extended layers (DATAPATH_EXT_CON 0x324, bits 0-2 = EL0-EL2 on). Boot 2026-11-14 with the strip back: ovl0
+		 * ext_con 0x20001 (EL0 on), and only L0, ours, among the four layers; boots without the strip read 0x10000.
+		 * Android's navigation bar is EL0. iOS never uses extended layers: all of them are turned off. Their
+		 * registers (CON 0x960, SRC_SIZE 0x968, OFFSET 0x96c, PITCH 0x974 at +0x20 per layer, ADDR 0xfb0 + 4 per
+		 * layer) are logged to check that reading.
+		 */
+		uint32_t ext = r[0x324 / 4];
+		for (unsigned n = 0; n < 3; n++) {
+			if (((ext >> n) & 1) == 0) {
+				continue;
+			}
+			uint32_t size = r[(0x968 + 0x20 * n) / 4], offset = r[(0x96c + 0x20 * n) / 4];
+			IOLog("SWEET OVL: %s EL%u on addr %#x %ux%u at %u,%u pitch %u con %#x%s\n", engines[e].name, n,
+			    r[(0xfb0 + 4 * n) / 4], size & 0xffff, size >> 16, offset & 0xffff, offset >> 16,
+			    r[(0x974 + 0x20 * n) / 4] & 0xffff, r[(0x960 + 0x20 * n) / 4], apply ? ": turned off" : "");
+		}
+		if (apply && (ext & 7) != 0) {
+			r[0x324 / 4] = ext & ~7u;
+			IOSleep(50);
+			IOLog("SWEET OVL: %s ext_con %#x -> %#x, reads back %#x\n", engines[e].name, ext, ext & ~7u, r[0x324 / 4]);
+		}
 		if (apply && keep != src) {
 			r[0x2c / 4] = keep;
 			IOSleep(50);            /* a frame or two: the engine takes new values at the start of a frame */
