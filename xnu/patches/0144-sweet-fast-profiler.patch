+/*
+ * SWEET profiler (bsd/dev/sweet_prof.c): what this CPU was running when the
+ * profiler's cross-call interrupt came in. Interrupted in user mode, the
+ * interrupt's saved state is the thread's user state; in the kernel, the
+ * user state is the one at its last kernel entry and the kernel pc is kept
+ * too (unslid). The struct is the same in sweet_prof.c.
+ */
+#include <arm/cpu_data_internal.h>
+#include <arm64/proc_reg.h>
+
+struct sweet_prof_hit {
+	uint64_t pc, lr, fp, kpc, tid;
+	void *task;
+	int32_t pid;
+	uint16_t flags;                 /* 1 sampled, 2 user mode, 4 idle, 8 kernel thread */
+	uint16_t cpu;
+};
+void sweet_prof_cpu(void *arg);
+int sweet_prof_walk(void *task, uint64_t fp, uint64_t *out, int max);
+int sweet_prof_thread_name(void *task, uint64_t tid, char *buf, size_t size);
+void sweet_prof_task_ref(void *task, int add);
+extern void bsd_getthreadname(void *uth, char *buffer);
+
+void
+sweet_prof_cpu(void *arg)
+{
+	thread_t th = current_thread();
+	task_t task = get_threadtask(th);
+	arm_saved_state_t *st = (arm_saved_state_t *)getCpuDatap()->cpu_int_state;
+	arm_saved_state_t *us;
+	struct sweet_prof_hit *h;
+	int cpu = cpu_number();
+	bool user;
+
+	if (cpu < 0 || cpu >= 16) {
+		return;
+	}
+	h = &((struct sweet_prof_hit *)arg)[cpu];
+	h->tid = thread_tid(th);
+	h->task = task;
+	h->pid = 0;
+	h->pc = h->lr = h->fp = h->kpc = 0;
+	if (th == current_processor()->idle_thread) {
+		h->flags = 1 | 4;
+		return;
+	}
+	user = st != NULL && is_saved_state64(st) && PSR64_IS_USER(get_saved_state_cpsr(st));
+	if (!user && st != NULL && is_saved_state64(st)) {
+		h->kpc = VM_KERNEL_UNSLIDE(get_saved_state_pc(st));
+	}
+	if (task == kernel_task || task == TASK_NULL) {
+		h->flags = 1 | 8;
+		return;
+	}
+	h->pid = task_pid(task);
+	us = user ? st : find_user_regs(th);
+	if (us != NULL && is_saved_state64(us)) {
+		h->pc = get_saved_state_pc(us);
+		h->lr = get_saved_state_lr(us);
+		h->fp = get_saved_state_fp(us);
+	}
+	h->flags = 1 | (user ? 2 : 0);
+}
+
+/* The user frame chain from fp, from the profiler's thread (process context). */
+int
+sweet_prof_walk(void *t, uint64_t fp, uint64_t *out, int max)
+{
+	task_t task = (task_t)t;
+	vm_map_t map;
+	int n = 0;
+
+	task_lock(task);
+	map = task->map;
+	if (map != VM_MAP_NULL) {
+		vm_map_reference(map);
+	}
+	task_unlock(task);
+	if (map == VM_MAP_NULL) {
+		return 0;
+	}
+	while (n < max && fp != 0 && (fp & 7) == 0) {
+		uint64_t frame[2];
+		if (vm_map_read_user(map, fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+			break;
+		}
+		out[n++] = frame[1];
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+	vm_map_deallocate(map);
+	return n;
+}
+
+int
+sweet_prof_thread_name(void *t, uint64_t tid, char *buf, size_t size)
+{
+	task_t task = (task_t)t;
+	thread_t thread;
+	char name[64];
+	int found = 0;
+
+	bzero(name, sizeof(name));
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		if (thread_tid(thread) == tid) {
+			void *uth = get_bsdthread_info(thread);
+			if (uth != NULL) {
+				bsd_getthreadname(uth, name);
+			}
+			found = 1;
+			break;
+		}
+	}
+	task_unlock(task);
+	name[sizeof(name) - 1] = 0;
+	strlcpy(buf, name, size);
+	return found;
+}
+
+void
+sweet_prof_task_ref(void *t, int add)
+{
+	if (add > 0) {
+		task_reference((task_t)t);
+	} else {
+		task_deallocate((task_t)t);
+	}
+}
+
