 /*
+ * After a failed data transfer the card may still be in its data state (a multi-block read whose
+ * auto-CMD12 never ran): stop it with CMD12 (R1b) and wait until CMD13 reports "tran", so that the
+ * next command, DMA or PIO, is answered. msdc_cmd() resets a busy controller first.
+ */
+static int
+msdc_recover_card(void)
+{
+	int stop = msdc_cmd(12, 0, 7, 0, 0, 0, NULL);
+	int ready = msdc_card_ready();
+
+	printf("SWEET EMMC: recovery: CMD12 %d, card ready %d (sts %#x int %#x pb2 %#x)\n", stop, ready,
+	    ufs_rd(M_SDC_STS), ufs_rd(M_INT), ufs_rd(M_PATCH_BIT2));
+	return ready;
+}
+
+/*
  * Transfer nsec sectors between the card and the bounce buffer with the MSDC DMA engine.
  * Addresses are 36 bits wide: the high nibble goes into the descriptors and into DMA_SA_H4BIT.
  */
