+	    fStatCopies ? sweet_fb_rowread_us / fStatCopies : 0, fStatCopies ? fStatWaitUs / fStatCopies : 0,
+	    sweet_fb_shadow_used, sweet_fb_shadow_scaled);
 	sweet_fb_rowread_us = 0;
