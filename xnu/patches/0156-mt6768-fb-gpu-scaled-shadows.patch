+			 * Patch 0156: a panel-sized copy of this frame drawn by the GPU (libsweet-gl): copied one to one, ~1 ms
+			 * instead of 13.6 ms of scaling here. Only for a whole-screen layer at the origin.
+			 */
+			uint32_t shadowID = sweet_fb_shadow_take(id);
+			SweetSurface *p = shadowID != 0 && sx == 0 && sy == 0 && dx == 0 && dy == 0 &&
