diff --git a/bsd/dev/sweet_mali.c b/bsd/dev/sweet_mali.c
index 806b253..ced7aff 100644
--- a/bsd/dev/sweet_mali.c
+++ b/bsd/dev/sweet_mali.c
@@ -1444,4 +1444,130 @@ sweet_mali_init(void)
 		printf("SWEET MALI: kernel_thread_start failed\n");
 	}
 }
+
+/*
+ * Patch 0156: frames scaled to the panel by the GPU. The panel copy (SweetFramebuffer.cpp) scales the presented
+ * 828x1792 surface down to the 720x1604 panel on the CPU: 13.6 ms a frame, while a one-to-one copy takes ~1 ms
+ * (payload-u, 2026-11-26). libsweet-gl draws every frame of a surface the display shows once more, scaled by the
+ * GPU (linear filter), into a panel-sized surface of its own -- its "shadow" -- and tells the kernel here which one
+ * belongs to which, after each such draw. The display copies the shadow one to one when the swapped surface has one
+ * that was drawn since its last swap, and scales the surface itself otherwise.
+ *
+ * sysctl sweetmali.fbshadow: write { uint32 src, uint32 dst } (dst 0: forget src); read { uint32 panel w, h,
+ * presented w, h, the last four surfaces swapped }. Boot-arg sweetfbshadow=0: never used.
+ */
+#define SWEET_FB_SHADOWS 8
+static struct {
+	uint32_t src, dst;
+	bool fresh;
+} fb_shadows[SWEET_FB_SHADOWS];
+static uint32_t fb_shadow_info[8];              /* panel w, h, presented w, h, swapped[4] */
+static uint32_t fb_swapped_at;
+static int fb_shadow_on = -1;
+static LCK_MTX_DECLARE(fb_shadow_lock, &mali_lock_group);
+
+static bool
+fb_shadow_enabled(void)
+{
+	if (fb_shadow_on < 0) {
+		int v = 1;
+		(void)PE_parse_boot_argn("sweetfbshadow", &v, sizeof(v));
+		fb_shadow_on = v != 0;
+	}
+	return fb_shadow_on != 0;
+}
+
+/* SweetFramebuffer.cpp: the panel's and the presented size, once */
+void
+sweet_fb_shadow_dims(uint32_t pw, uint32_t ph, uint32_t lw, uint32_t lh)
+{
+	lck_mtx_lock(&fb_shadow_lock);
+	fb_shadow_info[0] = pw;
+	fb_shadow_info[1] = ph;
+	fb_shadow_info[2] = lw;
+	fb_shadow_info[3] = lh;
+	lck_mtx_unlock(&fb_shadow_lock);
+}
+
+/*
+ * SweetFramebuffer.cpp, at a swap of surface src: its shadow if one was drawn since the last swap (taken: the next
+ * swap needs a new draw), else 0. The swap is noted either way (the library draws shadows only for surfaces swapped).
+ */
+uint32_t
+sweet_fb_shadow_take(uint32_t src)
+{
+	uint32_t dst = 0;
+	bool seen = false;
+
+	if (!fb_shadow_enabled() || src == 0) {
+		return 0;
+	}
+	lck_mtx_lock(&fb_shadow_lock);
+	for (int i = 0; i < SWEET_FB_SHADOWS; i++) {
+		if (fb_shadows[i].src == src && fb_shadows[i].dst != 0) {
+			/*
+			 * Round ae: 67 of 249 swaps came with no new shadow -- frames CoreAnimation swapped without drawing
+			 * into the surface. The shadow drawn last is still that surface's picture then (the library draws it
+			 * every time it draws the surface), so it is used either way; "fresh" is kept for the statistics.
+			 */
+			dst = fb_shadows[i].dst;
+			fb_shadows[i].fresh = false;
+			break;
+		}
+	}
+	for (int i = 0; i < 4; i++) {
+		seen |= fb_shadow_info[4 + i] == src;
+	}
+	if (!seen) {
+		fb_shadow_info[4 + (fb_swapped_at++ & 3)] = src;
+	}
+	lck_mtx_unlock(&fb_shadow_lock);
+	return dst;
+}
+
+static int
+sysctl_fbshadow SYSCTL_HANDLER_ARGS
+{
+#pragma unused(oidp, arg1, arg2)
+	uint32_t info[8], pair[2];
+	int error;
+
+	lck_mtx_lock(&fb_shadow_lock);
+	memcpy(info, fb_shadow_info, sizeof(info));
+	lck_mtx_unlock(&fb_shadow_lock);
+	if (!fb_shadow_enabled()) {
+		info[0] = info[1] = 0;
+	}
+	error = SYSCTL_OUT(req, info, sizeof(info));
+	if (error != 0 || req->newptr == USER_ADDR_NULL) {
+		return error;
+	}
+	if (req->newlen != sizeof(pair)) {
+		return EINVAL;
+	}
+	error = SYSCTL_IN(req, pair, sizeof(pair));
+	if (error != 0) {
+		return error;
+	}
+	lck_mtx_lock(&fb_shadow_lock);
+	int slot = -1, empty = -1;
+	for (int i = 0; i < SWEET_FB_SHADOWS; i++) {
+		if (fb_shadows[i].src == pair[0] && fb_shadows[i].dst != 0) {
+			slot = i;
+		} else if (fb_shadows[i].dst == 0 && empty < 0) {
+			empty = i;
+		}
+	}
+	if (slot < 0) {
+		slot = empty >= 0 ? empty : (int)(pair[0] % SWEET_FB_SHADOWS);
+	}
+	fb_shadows[slot].src = pair[0];
+	fb_shadows[slot].dst = pair[1];
+	fb_shadows[slot].fresh = pair[1] != 0;
+	lck_mtx_unlock(&fb_shadow_lock);
+	return 0;
+}
+SYSCTL_PROC(_sweetmali, OID_AUTO, fbshadow, CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED, NULL, 0,
+    sysctl_fbshadow, "S", "panel shadows of presented surfaces (patch 0156)");
+
 #endif /* ARM64_BOARD_CONFIG_SWEET */
