+/* The daemon's side: a service of its own, so that its calls cannot be mistaken for a program's. */
+class SweetAccelControl : public IOService
+{
+	OSDeclareDefaultStructors(SweetAccelControl);
+
+public:
+	virtual bool start(IOService * provider) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(SweetAccelControl, IOService);
+
+bool
+SweetAccelControl::start(IOService * provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "SweetAccelControlUserClient");
+	setName("SweetAccelControl");
+	registerService();
+	return true;
+}
