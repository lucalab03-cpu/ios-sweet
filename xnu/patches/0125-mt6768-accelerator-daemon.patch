+/* The queue between the programs' calls and the daemon: a slot is free (0), waiting for the daemon (1),
+ * taken by it (2), answered (3) or given up by the caller (4, the daemon's answer frees it). */
+#define ACC_SLOTS 16
+struct accel_slot {
+	uint32_t state;
+	struct accel_ctrl_req req;
+	struct accel_ctrl_reply rep;
+};
+static struct accel_slot gSlots[ACC_SLOTS];
+static IOLock * gAccelLock;
+static bool gDaemonThere;
+static bool gWaitedForDaemon;
+
+static void
+accel_wait_ms(uint32_t ms)
+{
+	IOSleep(ms);
+}
