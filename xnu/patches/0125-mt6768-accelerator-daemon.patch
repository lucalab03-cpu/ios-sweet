+bool
+SweetAccelControlUserClient::initWithTask(task_t owningTask, void * securityID, UInt32 type)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type)) {
+		return false;
+	}
+	gDaemonThere = true;
+	IOLog("SWEET ACCEL: the daemon is connected\n");
+	return true;
+}
