+/* Selectors above 0xff00 are not requests of a program: they are its events (open, close, memory, ...). */
+enum {
+	kEventOpen   = 0xff00,
+	kEventClose  = 0xff01,
+	kEventMemory = 0xff02,
+	kEventTrap   = 0xff03,
+	kEventNotify = 0xff04,
+};
+
+IOReturn
+SweetAccelUserClient::forward(uint32_t selector, uint32_t nsin, const uint64_t * sin, const void * in, uint32_t insize,
+    uint32_t outwanted, uint32_t nsoutwanted, uint32_t * nsout, uint64_t * sout, void * out, uint32_t * outsize)
+{
+	struct accel_slot * s = NULL;
+	uint32_t index = 0;
+	IOReturn result;
+
+	if (gAccelLock == NULL) {
+		return kIOReturnUnsupported;
+	}
+	/* the daemon may start a little after the first request: wait for it once, up to 15 s */
+	if (!gDaemonThere && !gWaitedForDaemon) {
+		for (uint32_t i = 0; i < 1500 && !gDaemonThere; i++) {
+			accel_wait_ms(10);
+		}
+		gWaitedForDaemon = true;
+	}
+	if (!gDaemonThere) {
+		return kIOReturnUnsupported;
+	}
+	IOLockLock(gAccelLock);
+	for (uint32_t i = 0; i < ACC_SLOTS; i++) {
+		if (gSlots[i].state == 0) {
+			s = &gSlots[i];
+			index = i;
+			break;
+		}
+	}
+	if (s == NULL) {
+		IOLockUnlock(gAccelLock);
+		return kIOReturnNoResources;
+	}
+	bzero(&s->req, sizeof(s->req));
+	bzero(&s->rep, sizeof(s->rep));
+	s->req.slot = index;
+	s->req.selector = selector;
+	s->req.type = fType;
+	s->req.pid = (uint32_t)proc_selfpid();
+	s->req.nsin = nsin > ACC_SCALARS ? ACC_SCALARS : nsin;
+	for (uint32_t i = 0; i < s->req.nsin; i++) {
+		s->req.sin[i] = sin[i];
+	}
+	s->req.insize = insize > ACC_MAXIN ? ACC_MAXIN : insize;
+	if (in != NULL && s->req.insize != 0) {
+		bcopy(in, s->req.in, s->req.insize);
+	}
+	s->req.outwanted = outwanted;
+	s->req.pad = nsoutwanted;
+	s->state = 1;
+	IOLockUnlock(gAccelLock);
+
+	for (uint32_t i = 0; i < 20000; i++) {     /* up to 20 s */
+		if (*(volatile uint32_t *)&s->state == 3) {
+			break;
+		}
+		accel_wait_ms(1);
+	}
+	IOLockLock(gAccelLock);
+	if (s->state != 3) {
+		s->state = 4;                           /* the daemon's late answer frees it */
+		IOLockUnlock(gAccelLock);
+		return kIOReturnTimeout;
+	}
+	result = (IOReturn)s->rep.result;
+	if (nsout != NULL) {
+		*nsout = s->rep.nsout > ACC_SCALARS ? ACC_SCALARS : s->rep.nsout;
+		for (uint32_t i = 0; i < *nsout && sout != NULL; i++) {
+			sout[i] = s->rep.sout[i];
+		}
+	}
+	if (outsize != NULL) {
+		*outsize = s->rep.outsize > ACC_MAXIN ? ACC_MAXIN : s->rep.outsize;
+		if (out != NULL && *outsize != 0) {
+			bcopy(s->rep.out, out, *outsize);
+		}
+	}
+	s->state = 0;
+	IOLockUnlock(gAccelLock);
+	return result;
+}
