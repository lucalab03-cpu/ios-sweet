+IOReturn
+SweetAccelControlUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments * args,
+    IOExternalMethodDispatch * dispatch, OSObject * target, void * reference)
+{
+	(void)dispatch;
+	(void)target;
+	(void)reference;
+	if (selector == 0) {
+		/* the next request: wait up to 5 s for one */
+		if (args->structureOutput == NULL || args->structureOutputSize < sizeof(struct accel_ctrl_req)) {
+			return kIOReturnBadArgument;
+		}
+		for (uint32_t i = 0; i < 5000; i++) {
+			IOLockLock(gAccelLock);
+			for (uint32_t n = 0; n < ACC_SLOTS; n++) {
+				if (gSlots[n].state == 1) {
+					gSlots[n].state = 2;
+					bcopy(&gSlots[n].req, args->structureOutput, sizeof(struct accel_ctrl_req));
+					args->structureOutputSize = sizeof(struct accel_ctrl_req);
+					IOLockUnlock(gAccelLock);
+					return kIOReturnSuccess;
+				}
+			}
+			IOLockUnlock(gAccelLock);
+			accel_wait_ms(1);
+		}
+		return kIOReturnTimeout;
+	}
+	if (selector == 1) {
+		const struct accel_ctrl_reply * r = (const struct accel_ctrl_reply *)args->structureInput;
+		IOReturn ret = kIOReturnSuccess;
+
+		if (r == NULL || args->structureInputSize < sizeof(*r) || r->slot >= ACC_SLOTS) {
+			return kIOReturnBadArgument;
+		}
+		IOLockLock(gAccelLock);
+		if (gSlots[r->slot].state == 2) {
+			bcopy(r, &gSlots[r->slot].rep, sizeof(*r));
+			gSlots[r->slot].state = 3;
+		} else if (gSlots[r->slot].state == 4) {
+			gSlots[r->slot].state = 0;      /* the caller gave up: nobody waits for this */
+		} else {
+			ret = kIOReturnNotPermitted;
+		}
+		IOLockUnlock(gAccelLock);
+		return ret;
+	}
+	return kIOReturnUnsupported;
+}
