+/*
+ * Patch 0169: tearing. The copy into the panel memory (0156: ~1.3 ms, one to one) ran as soon as a frame's GPU work
+ * was done, at any point of the panel's scan of that same memory: the overlay engine read the top of one frame and the
+ * bottom of the next, and what moved sideways showed steps (fix13, 2026-11-27: every picture of the composed frame was
+ * clean, the panel showed bars at the left edge of moving widgets). The overlay engine (disp_ovl0, as in Linux's
+ * mtk_disp_ovl.c: INTEN 0x4, INTSTA 0x8, bit 1 frame complete) sets its frame-done status at the end of each frame it
+ * sends, whether or not the interrupt is on. The presenter clears it, waits for it (at most 25 ms) and copies then:
+ * the copy, top down, is ~12 times faster than the scan and starts in the blanking, so it stays ahead of the scan.
+ * At start the bit is watched for 100 ms: its period is logged (the panel's real refresh), and with no frame done
+ * seen this stays off. sweetfb_tearfree=0: off.
+ */
+void
+AppleCLCD::tearFreeStart(void)
+{
+	int on = 1;
+	IOMemoryDescriptor *md;
+
+	PE_parse_boot_argn("sweetfb_tearfree", &on, sizeof(on));
+	if (!on || (md = IOMemoryDescriptor::withPhysicalAddress(0x1400b000ULL, 0x1000, kIODirectionInOut)) == NULL) {
+		return;
+	}
+	fOvlMap = md->map(kIOMapInhibitCache);
+	md->release();
+	if (fOvlMap == NULL) {
+		IOLog("SWEET FB: 0169 disp_ovl0 cannot be mapped: frames copied at any time\n");
+		return;
+	}
+	fOvl = (volatile uint32_t *)fOvlMap->getVirtualAddress();
+	uint32_t inten = fOvl[0x4 / 4], first = fOvl[0x8 / 4], seen = 0;
+	uint64_t t0 = mach_absolute_time(), last = 0, sum = 0, ns, now;
+
+	fOvl[0x8 / 4] = 0;
+	for (;;) {
+		now = mach_absolute_time();
+		absolutetime_to_nanoseconds(now - t0, &ns);
+		if (ns > 100 * NSEC_PER_MSEC) {
+			break;
+		}
+		if ((fOvl[0x8 / 4] & 2) != 0) {
+			fOvl[0x8 / 4] = 0;
+			if (last != 0) {
+				absolutetime_to_nanoseconds(now - last, &ns);
+				sum += ns / 1000;
+			}
+			last = now;
+			seen++;
+		}
+		IODelay(50);
+	}
+	fTearFree = seen >= 2;
+	IOLog("SWEET FB: 0169 disp_ovl0 inten %#x intsta %#x: %u frames done in 100 ms, one every %llu us: %s\n", inten,
+	    first, seen, seen >= 2 ? sum / (seen - 1) : 0, fTearFree ? "frames copied into the panel after a frame done" :
+	    "no frame done seen, frames copied at any time");
+}
+
+/* (presenter thread, fPresentLock held) until the overlay engine has sent a frame, so the copy starts in the blanking */
+void
+AppleCLCD::waitScanout(void)
+{
+	uint64_t t0, now, ns;
+
+	if (!fTearFree || fOvl == NULL) {
+		return;
+	}
+	t0 = mach_absolute_time();
+	fOvl[0x8 / 4] = 0;
+	for (;;) {
+		if ((fOvl[0x8 / 4] & 2) != 0) {
+			fTearMisses = 0;
+			break;
+		}
+		now = mach_absolute_time();
+		absolutetime_to_nanoseconds(now - t0, &ns);
+		if (ns > 25 * NSEC_PER_MSEC) {
+			fStatTearMissed++;
+			if (++fTearMisses >= 5) {
+				fTearFree = false;
+				IOLog("SWEET FB: 0169 no frame done in five waits of 25 ms: frames copied at any time from now on\n");
+			}
+			break;
+		}
+		delay_for_interval(100, NSEC_PER_USEC);
+	}
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	fStatTearUs += ns / 1000;
+	if (ns / 1000 > fStatTearMax) {
+		fStatTearMax = ns / 1000;
+	}
+}
