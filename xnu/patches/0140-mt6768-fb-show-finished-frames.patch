+/* Patch 0140: the pending frame into the panel now, once the GPU chains queued before its swap have run. */
+void
+AppleCLCD::presentNow(void)
+{
+	uint64_t gpu[2], deadline, started = mach_absolute_time(), ns;
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+
+	if (rec == NULL) {
+		return;
+	}
+	IOLockLock(fLock);
+	gpu[0] = fPendingGPU[0];
+	gpu[1] = fPendingGPU[1];
+	IOLockUnlock(fLock);
+	if (!sweet_mali_fence_done(gpu[0]) || !sweet_mali_fence_done(gpu[1])) {
+		clock_interval_to_deadline(100, kMillisecondScale, &deadline);
+		(void)sweet_mali_fences_wait(gpu, 2, true, deadline, NULL);
+		absolutetime_to_nanoseconds(mach_absolute_time() - started, &ns);
+		fStatWaited++;
+		if (ns / 1000 > fStatWaitMax) {
+			fStatWaitMax = ns / 1000;
+		}
+	}
+	IOLockLock(fPresentLock);
+	IOLockLock(fLock);
+	memcpy(rec, fPending, SWEET_FB_SWAP_REC_SIZE);
+	bool show = fDirty && !fPowerOff;
+	if (show) {
+		fDirty = false;
+	}
+	IOLockUnlock(fLock);
+	if (show) {
+		present(rec);
+		fStatSync++;
+	}
+	IOLockUnlock(fPresentLock);
+	IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
+}
