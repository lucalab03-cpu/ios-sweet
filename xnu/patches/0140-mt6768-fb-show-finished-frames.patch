+/* Patch 0140: the newest chain queued on each slot (fences; 0 0 without the queue). Any thread. */
+void
+sweet_mali_submitted(uint64_t out[2])
+{
+	if (!queue_on()) {
+		out[0] = out[1] = 0;
+		return;
+	}
+	lck_mtx_lock(&queue_lock);
+	out[0] = slots[0].submitted ? fence_of(0, slots[0].submitted) : 0;
+	out[1] = slots[1].submitted ? fence_of(1, slots[1].submitted) : 0;
+	lck_mtx_unlock(&queue_lock);
+}
