+/* 0171: the next vsync notification, one period on, in phase with the panel when its frames done are known */
+void
+AppleCLCD::vsyncArm(void)
+{
+	uint64_t now = mach_absolute_time(), next;
+
+	if (fVsyncPeriodAbs == 0) {
+		fVsync->setTimeoutUS(SWEET_FB_VSYNC_US);
+		return;
+	}
+	next = fNextVsync != 0 ? fNextVsync + fVsyncPeriodAbs : now + fVsyncPeriodAbs;
+	if (fVsyncLocked && fLastFrameDone != 0 && now - fLastFrameDone < 50 * fVsyncPeriodAbs) {
+		/* in phase with the last frame done: the first one of the panel's after now */
+		uint64_t k = (now - fLastFrameDone) / fVsyncPeriodAbs + 1;
+		next = fLastFrameDone + k * fVsyncPeriodAbs;
+	}
+	if (next <= now) {
+		next = now + fVsyncPeriodAbs;
+	}
+	fNextVsync = next;
+	fVsync->wakeAtTime(next);
+}
