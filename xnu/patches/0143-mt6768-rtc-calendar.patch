+/*
+ * Patch 0143: the date and time, from the MT6358's RTC (iOS showed 1969-12-31: nothing set the calendar). Android's
+ * rtc-mt6397 keeps the RTC in UTC ("setting system clock to 2026-11-15T00:14:32 UTC", Android dmesg); its registers sit
+ * at 0x0588 in the PMIC (MT6358_RTC_BASE), read through the PMIC wrapper's WACS2 channel as the keys driver does. Done
+ * once, before the keys driver starts polling the same channel. Boot-arg sweetrtc=0: not set.
+ */
+#define RTC_PWRAP_PA        0x1000d000u
+#define RTC_WACS2_CMD       0xc20u
+#define RTC_WACS2_RDATA     0xc24u
+#define RTC_WACS2_VLDCLR    0xc28u
+#define RTC_FSM(x)          (((x) >> 16) & 7u)
+#define RTC_BASE            0x0588u
+#define RTC_TC_SEC          0x000au
+#define RTC_TC_MIN          0x000cu
+#define RTC_TC_HOU          0x000eu
+#define RTC_TC_DOM          0x0010u
+#define RTC_TC_MTH          0x0014u
+#define RTC_TC_YEA          0x0016u
+#define RTC_MIN_YEAR        1968
+
+static int
+rtc_pmic_read(vm_offset_t pw, uint32_t adr, uint32_t *out)
+{
+	unsigned i;
+	uint32_t v = 0;
+
+	for (i = 0; i < 20000 && RTC_FSM(v = rd(pw, RTC_WACS2_RDATA)) != 0; i++) {
+		delay(1);
+	}
+	if (i == 20000) {
+		wr(pw, RTC_WACS2_VLDCLR, 1);
+		return ETIMEDOUT;
+	}
+	wr(pw, RTC_WACS2_CMD, (adr >> 1) << 16);
+	for (i = 0; i < 20000 && RTC_FSM(v = rd(pw, RTC_WACS2_RDATA)) != 6; i++) {
+		delay(1);
+	}
+	if (i == 20000) {
+		return ETIMEDOUT;
+	}
+	*out = v & 0xffffu;
+	wr(pw, RTC_WACS2_VLDCLR, 1);
+	return 0;
+}
+
+/* Days from 1970-01-01 to y-m-d (proleptic Gregorian). */
+static int64_t
+rtc_days(int64_t y, int64_t m, int64_t d)
+{
+	y -= m <= 2;
+	int64_t era = (y >= 0 ? y : y - 399) / 400;
+	int64_t yoe = y - era * 400;
+	int64_t doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+	int64_t doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+	return era * 146097 + doe - 719468;
+}
+
+static void
+rtc_set_calendar(void)
+{
+	int on = 1;
+	vm_offset_t pw;
+	uint32_t sec = 0, min = 0, hou = 0, dom = 0, mth = 0, yea = 0, sec2 = 0;
+
+	(void)PE_parse_boot_argn("sweetrtc", &on, sizeof(on));
+	if (!on || (pw = ml_io_map(RTC_PWRAP_PA, 0x1000)) == 0) {
+		return;
+	}
+	for (int tries = 0; tries < 3; tries++) {
+		if (rtc_pmic_read(pw, RTC_BASE + RTC_TC_SEC, &sec) || rtc_pmic_read(pw, RTC_BASE + RTC_TC_MIN, &min) ||
+		    rtc_pmic_read(pw, RTC_BASE + RTC_TC_HOU, &hou) || rtc_pmic_read(pw, RTC_BASE + RTC_TC_DOM, &dom) ||
+		    rtc_pmic_read(pw, RTC_BASE + RTC_TC_MTH, &mth) || rtc_pmic_read(pw, RTC_BASE + RTC_TC_YEA, &yea) ||
+		    rtc_pmic_read(pw, RTC_BASE + RTC_TC_SEC, &sec2)) {
+			printf("SWEET RTC: the PMIC wrapper did not answer\n");
+			return;
+		}
+		if ((sec2 & 0x3f) >= (sec & 0x3f)) {
+			break;          /* no minute rolled over in between */
+		}
+	}
+	int64_t y = (int64_t)(yea & 0x7f) + RTC_MIN_YEAR, mo = mth & 0x0f, d = dom & 0x1f;
+	int64_t h = hou & 0x1f, mi = min & 0x3f, se = sec2 & 0x3f;
+	if (y < 2020 || y > 2090 || mo < 1 || mo > 12 || d < 1 || d > 31 || h > 23 || mi > 59 || se > 59) {
+		printf("SWEET RTC: unlikely time %lld-%lld-%lld %lld:%lld:%lld (raw yea %#x mth %#x dom %#x), not set\n",
+		    y, mo, d, h, mi, se, yea, mth, dom);
+		return;
+	}
+	int64_t secs = rtc_days(y, mo, d) * 86400 + h * 3600 + mi * 60 + se;
+	clock_set_calendar_microtime((clock_sec_t)secs, 0);
+	printf("SWEET RTC: %04lld-%02lld-%02lld %02lld:%02lld:%02lld UTC from the MT6358, calendar set (%lld)\n",
+	    y, mo, d, h, mi, se, secs);
+}
+
