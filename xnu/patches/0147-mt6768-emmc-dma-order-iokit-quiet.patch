 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
 
+/*
+ * Patch 0147: IOPlatformExpertDevice keeps a busy count of 1 for ever (tools/sweetbusy, boot of 2026-11-24 22:58:
+ * "BUSY IOPlatformExpertDevice "D22AP" busy 1", IOKitWaitQuiet NOT quiet; 197 services, no other one busy). configd's
+ * InterfaceNamer waits for IOKit to go quiet, and Settings > General > About waits for it
+ * (_SCNetworkInterfaceCopyAllWithPreferences -> SCDynamicStoreNotifyWait). After sweetquiet seconds (default 90,
+ * 0 = never) whatever busy count the device still has is logged and released. Which matching holds it shows with
+ * boot-arg io=0x16 (probe, start, match).
+ */
+static void
+sweet_pe_quiet(void *arg, wait_result_t wr)
+{
+	IOService *device = (IOService *)arg;
+	int secs = 90;
+
+	(void)wr;
+	PE_parse_boot_argn("sweetquiet", &secs, sizeof(secs));
+	if (secs > 0) {
+		IOSleep((unsigned)secs * 1000);
+		UInt32 busy = device->getBusyState();
+		IOLog("SWEET: %s busy %u after %d s%s\n", device->getName(), (unsigned)busy, secs,
+		    busy ? ": released, so that IOKit goes quiet" : "");
+		if (busy != 0) {
+			device->adjustBusy(-(SInt32)busy);
+		}
+	}
+	device->release();
+}
+
 bool
 SweetPlatformExpert::start(IOService *provider)
 {
@@ -31,6 +61,13 @@
 	}
 	registerService();
 	IOLog("SWEET: platform expert registered\n");
+	thread_t quiet;
+	provider->retain();
+	if (kernel_thread_start(sweet_pe_quiet, provider, &quiet) == KERN_SUCCESS) {
+		thread_deallocate(quiet);
+	} else {
+		provider->release();
+	}
 	return true;
 }
 
