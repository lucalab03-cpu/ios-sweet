+	if (n == 0 || n > SWEET_SYNC_HANDLES_MAX ||
+	    copyin((user_addr_t) request->handles, handles, n * sizeof(uint32_t)) != 0) {
+		return kIOReturnBadArgument;
+	}
+	for (;;) {
