+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
+ * The job queue (patch 0135; boot-arg sweetmaliasync, default 1, 0 = every job run to its end in its caller)
+ *
+ * Until now every job chain ran to its end inside the SUBMIT call, one at a time for the whole GPU: the program
+ * waited for each pass before it could send the next, and the two job slots never worked together (boot 2026-11-14:
+ * 105-124 ms from a frame's commit to its completion). Here a SUBMIT only queues the chain and returns: a kernel
+ * thread starts it when its slot is free and every chain it depends on has finished, so the GPU runs the vertex and
+ * tiler jobs of one pass (slot 1) while the fragment jobs of the previous one run (slot 0), and the program goes on
+ * recording while the GPU works.
+ *
+ * A chain is known by its fence: the slot in bit 62, its place in that slot's order below (1, 2, ...). Chains of
+ * one slot start and end in order, so "finished" is a comparison with the slot's count of finished chains. The GPU's
+ * interrupt is not wired on this board: the thread looks at JOB_INT_RAWSTAT, 200 us apart, while a chain runs, and
+ * sleeps when nothing does. A chain that ends with a fault is stopped (JS_COMMAND_NEXT NOP, as Open Mapple's MappleGPU
+ * does on the job-manager Mali-G57) and the GPU is reset once the other slot has finished, as the synchronous path
+ * always did after a fault (Mapple resets only after bus faults; here a fault often leaves the MMU stalled). A chain
+ * that does not end in 2 s hangs: whatever runs is ended and the GPU reset at once.
+ *
+ * Which chains wait for which is the service's business (SweetMali.cpp): each program's in their order, as Linux
+ * orders them through the buffers they share.
+ * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+#define QUEUE_JOBS          512             /* per slot; a SUBMIT waits for room past this */
+#define QUEUE_DEPS          8
+#define FENCE_SLOT_SHIFT    62
+#define FENCE_SEQ_MASK      ((1ull << FENCE_SLOT_SHIFT) - 1)
+#define JS_COMMAND_NOP      0u
+#define JOB_TIMEOUT_MS      2000u
+#define POLL_US             200u
+
+struct queued_job {
+	uint64_t chain, seq, queued, started;
+	uint64_t deps[QUEUE_DEPS];
+	uint32_t ndeps;
+};
+
+static struct queue_slot {
+	struct queued_job jobs[QUEUE_JOBS];
+	uint8_t status[QUEUE_JOBS];            /* by seq % QUEUE_JOBS: how each recent chain ended (0 = done) */
+	uint32_t head, count;                  /* jobs[head] is the oldest not finished (running when `running`) */
+	uint64_t submitted, finished;          /* seqs */
+	bool running;
+	uint32_t js;
+} slots[2];
+
+static LCK_MTX_DECLARE(queue_lock, &mali_lock_group);
+static int queue_mode = -1;                 /* -1: not decided; 0: off; 1: on and the thread runs */
+static int queue_thread_chan, queue_done_chan;
+static uint32_t queue_holds;                /* sweet_mali_mapped() is waiting for the GPU to be idle, or using it */
+static bool queue_reset_wanted;
+static uint64_t queue_timeout;              /* JOB_TIMEOUT_MS in mach_absolute_time units */
+
+/* what the queue did, logged every 256 chains (with the GPU time of each slot, and how long the two overlapped) */
+static struct {
+	uint64_t chains, busy[2], both, waitQueue, longest, faults, resets, first, last, bothSince;
+} qstats;
+
+static bool
+queue_on(void)
+{
+	return queue_mode == 1;
+}
+
+static inline uint64_t
+fence_of(uint32_t slot, uint64_t seq)
+{
+	return ((uint64_t)slot << FENCE_SLOT_SHIFT) | seq;
+}
+
+/* With queue_lock held. A fence of 0 is "nothing to wait for". */
+static bool
+fence_finished(uint64_t fence)
+{
+	uint32_t slot = (uint32_t)(fence >> FENCE_SLOT_SHIFT) & 1;
+	uint64_t seq = fence & FENCE_SEQ_MASK;
+
+	return fence == 0 || slots[slot].finished >= seq;
+}
+
+static bool
+deps_finished(const struct queued_job *job)
+{
+	for (uint32_t i = 0; i < job->ndeps; i++) {
+		if (!fence_finished(job->deps[i])) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static uint64_t
+abs_to_us(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / 1000;
+}
+
+/* With queue_lock held: the oldest chain of `slot` is started. */
+static void
+start_job(uint32_t s)
+{
+	struct queue_slot *q = &slots[s];
+	struct queued_job *job = &q->jobs[q->head];
+	uint32_t js = q->js, bits = (1u << s) | (1u << (s + 16));
+	uint64_t now = mach_absolute_time();
+
+	wr(mali, JOB_INT_CLEAR, bits);
+	wr(mali, js + JS_HEAD_NEXT_LO, (uint32_t)job->chain);
+	wr(mali, js + JS_HEAD_NEXT_HI, (uint32_t)(job->chain >> 32));
+	wr(mali, js + JS_AFFINITY_NEXT_LO, shader_mask);
+	wr(mali, js + JS_AFFINITY_NEXT_HI, 0);
+	wr(mali, js + JS_CONFIG_NEXT, JS_CONFIG);
+	wr(mali, js + JS_COMMAND_NEXT, 1);
+	q->running = true;
+	job->started = now;
+	qstats.waitQueue += now - job->queued;
+	if (slots[s ^ 1].running) {
+		qstats.bothSince = now;
+	}
+	if (qstats.first == 0) {
+		qstats.first = now;
+	}
+}
+
+/* With queue_lock held: the running chain of `slot` ended with `status` (0 = done). */
+static void
+finish_job(uint32_t s, uint32_t status, uint64_t now)
+{
+	struct queue_slot *q = &slots[s];
+	struct queued_job *job = &q->jobs[q->head];
+	uint64_t took = now - job->started;
+
+	if (slots[s ^ 1].running && qstats.bothSince != 0) {
+		qstats.both += now - MAX(qstats.bothSince, job->started);
+		qstats.bothSince = 0;
+	}
+	q->status[job->seq % QUEUE_JOBS] = (uint8_t)(status > 0xff ? 0xff : status);
+	q->finished = job->seq;
+	q->head = (q->head + 1) % QUEUE_JOBS;
+	q->count--;
+	q->running = false;
+	qstats.chains++;
+	qstats.busy[s] += took;
+	qstats.longest = MAX(qstats.longest, took);
+	qstats.last = now;
+	if (status != 0) {
+		qstats.faults++;
+	}
+	if (qstats.chains == 256) {
+		printf("SWEET MALI: 256 chains in %llu ms: GPU %llu ms (slot 0 %llu, slot 1 %llu), both slots at once %llu ms, "
+		    "longest %llu ms, waiting in the queue %llu ms, %llu faults, %llu resets\n",
+		    abs_to_us(qstats.last - qstats.first) / 1000, abs_to_us(qstats.busy[0] + qstats.busy[1]) / 1000,
+		    abs_to_us(qstats.busy[0]) / 1000, abs_to_us(qstats.busy[1]) / 1000, abs_to_us(qstats.both) / 1000,
+		    abs_to_us(qstats.longest) / 1000, abs_to_us(qstats.waitQueue) / 1000, qstats.faults, qstats.resets);
+		bzero(&qstats, sizeof(qstats));
+	}
+	thread_wakeup((event_t)&queue_done_chan);
+}
+
+/* With queue_lock held, nothing running: reset, and every chain that was running is already finished. */
+static void
+queue_reset(const char *why)
+{
+	printf("SWEET MALI: GPU reset (%s)\n", why);
+	qstats.resets++;
+	gpu_reset_and_restore();
+	queue_reset_wanted = false;
+}
+
+/* With queue_lock held: what the running chains did since the last look. True while one still runs. */
+static bool
+poll_running(void)
+{
+	uint32_t raw = rd(mali, JOB_INT_RAWSTAT);
+	uint64_t now = mach_absolute_time();
+	bool busy = false;
+
+	for (uint32_t s = 0; s < 2; s++) {
+		struct queue_slot *q = &slots[s];
+		uint32_t done = 1u << s, failed = 1u << (s + 16);
+
+		if (!q->running) {
+			continue;
+		}
+		if (raw & failed) {
+			uint32_t status = rd(mali, q->js + JS_STATUS);
+			uint64_t fault = rd(mali, AS0 + 0x20) | ((uint64_t)rd(mali, AS0 + 0x24) << 32);
+
+			printf("SWEET MALI: chain %#llx on slot %u ended with status %#x (MMU irq %#x, fault %#x at %#llx)\n",
+			    q->jobs[q->head].chain, s, status, rd(mali, MMU_INT_RAWSTAT), rd(mali, AS0 + AS_FAULTSTATUS),
+			    (unsigned long long)fault);
+			wr(mali, q->js + JS_COMMAND_NEXT, JS_COMMAND_NOP);
+			wr(mali, JOB_INT_CLEAR, done | failed);
+			finish_job(s, status ? status : 0xfd, now);
+			if (rd(mali, MMU_INT_RAWSTAT) != 0) {
+				/* an MMU fault stalls the one address space every chain uses: the other slot's chain cannot end */
+				if (slots[s ^ 1].running) {
+					finish_job(s ^ 1, 0xfc, now);
+				}
+				queue_reset("an MMU fault");
+				return false;
+			}
+			/* the GPU is reset once the other slot is idle, as the synchronous path always did after a fault */
+			queue_reset_wanted = true;
+		} else if (raw & done) {
+			wr(mali, JOB_INT_CLEAR, done);
+			finish_job(s, 0, now);
+		} else if (now - q->jobs[q->head].started > queue_timeout) {
+			/* a chain that has not ended in 2 s hangs */
+			printf("SWEET MALI: chain %#llx on slot %u did not end in %u ms (status %#x)\n", q->jobs[q->head].chain, s,
+			    JOB_TIMEOUT_MS, rd(mali, q->js + JS_STATUS));
+			for (uint32_t o = 0; o < 2; o++) {
+				if (slots[o].running) {
+					finish_job(o, 0xff, now);       /* the reset ends whatever runs */
+				}
+			}
+			queue_reset("a chain hung");
+			return false;
+		} else {
+			busy = true;
+		}
+	}
+	return busy;
+}
+
+/* With queue_lock held: start what may start. */
+static void
+start_ready(void)
+{
+	if (queue_holds != 0) {
+		return;
+	}
+	if (queue_reset_wanted) {
+		if (slots[0].running || slots[1].running) {
+			return;
+		}
+		queue_reset("a chain ended with a fault");
+	}
+	for (uint32_t s = 0; s < 2; s++) {
+		struct queue_slot *q = &slots[s];
+
+		if (!q->running && q->count != 0 && deps_finished(&q->jobs[q->head])) {
+			start_job(s);
+		}
+	}
+}
+
+static void
+queue_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	lck_mtx_lock(&queue_lock);
+	for (;;) {
+		if (slots[0].running || slots[1].running) {
+			(void)poll_running();
+		}
+		start_ready();
+		if (slots[0].running || slots[1].running) {
+			uint64_t deadline;
+
+			clock_interval_to_deadline(POLL_US, NSEC_PER_USEC, &deadline);
+			(void)lck_mtx_sleep_deadline(&queue_lock, LCK_SLEEP_DEFAULT, (event_t)&queue_thread_chan, THREAD_UNINT,
+			    deadline);
+		} else {
+			/* nothing runs: woken by a SUBMIT or the end of a hold; a chain whose dependency never finishes is
+			 * looked at again every 10 ms */
+			uint64_t deadline;
+
+			clock_interval_to_deadline(10, NSEC_PER_MSEC, &deadline);
+			(void)lck_mtx_sleep_deadline(&queue_lock, LCK_SLEEP_DEFAULT, (event_t)&queue_thread_chan, THREAD_UNINT,
+			    (slots[0].count || slots[1].count) ? deadline : 0);
+		}
+	}
+}
+
+/* The chain into its slot's queue: its fence, or 0 (no queue). Waits for room when the slot has QUEUE_JOBS waiting. */
+static uint64_t
+queue_submit(uint64_t chain, bool fragment, const uint64_t *deps, uint32_t ndeps)
+{
+	uint32_t s = fragment ? 0 : 1;
+	struct queue_slot *q = &slots[s];
+	struct queued_job *job;
+	uint64_t fence;
+
+	lck_mtx_lock(&queue_lock);
+	while (q->count == QUEUE_JOBS) {
+		(void)lck_mtx_sleep(&queue_lock, LCK_SLEEP_DEFAULT, (event_t)&queue_done_chan, THREAD_UNINT);
+	}
+	job = &q->jobs[(q->head + q->count) % QUEUE_JOBS];
+	bzero(job, sizeof(*job));
+	job->chain = chain;
+	job->seq = ++q->submitted;
+	job->queued = mach_absolute_time();
+	for (uint32_t i = 0; i < ndeps; i++) {
+		if (!fence_finished(deps[i])) {
+			if (job->ndeps == QUEUE_DEPS) {
+				/* more than this: the newest of each slot stands for the others (chains end in order) */
+				uint32_t ds = (uint32_t)(deps[i] >> FENCE_SLOT_SHIFT) & 1;
+				for (uint32_t k = 0; k < job->ndeps; k++) {
+					if (((job->deps[k] >> FENCE_SLOT_SHIFT) & 1) == ds && job->deps[k] < deps[i]) {
+						job->deps[k] = deps[i];
+					}
+				}
+				continue;
+			}
+			job->deps[job->ndeps++] = deps[i];
+		}
+	}
+	q->count++;
+	q->status[job->seq % QUEUE_JOBS] = 0;
+	fence = fence_of(s, job->seq);
+	start_ready();
+	thread_wakeup((event_t)&queue_thread_chan);
+	lck_mtx_unlock(&queue_lock);
+	return fence;
+}
+
+/* Until every fence (or, !all, one of them) has finished, or the absolute deadline: true if they did. */
+static bool
+queue_wait(const uint64_t *fences, uint32_t count, bool all, uint64_t deadline, uint32_t *first)
+{
+	bool ok = false;
+
+	lck_mtx_lock(&queue_lock);
+	for (;;) {
+		uint32_t done = 0, firstDone = count;
+
+		for (uint32_t i = 0; i < count; i++) {
+			if (fence_finished(fences[i])) {
+				done++;
+				if (firstDone == count) {
+					firstDone = i;
+				}
+			}
+		}
+		if (count == 0 || (all ? done == count : done != 0)) {
+			if (first != NULL) {
+				*first = firstDone == count ? 0 : firstDone;
+			}
+			ok = true;
+			break;
+		}
+		if (deadline != 0 && mach_absolute_time() >= deadline) {
+			break;
+		}
+		(void)lck_mtx_sleep_deadline(&queue_lock, LCK_SLEEP_DEFAULT, (event_t)&queue_done_chan, THREAD_UNINT, deadline);
+	}
+	lck_mtx_unlock(&queue_lock);
+	return ok;
+}
+
+/* How a finished chain ended: 0 done, otherwise the slot's status (0xff: it hung). Recent chains only. */
+static uint32_t
+queue_status(uint64_t fence)
+{
+	uint32_t s = (uint32_t)(fence >> FENCE_SLOT_SHIFT) & 1, status;
+
+	lck_mtx_lock(&queue_lock);
+	status = slots[s].status[(fence & FENCE_SEQ_MASK) % QUEUE_JOBS];
+	lck_mtx_unlock(&queue_lock);
+	return status;
+}
+
+/* No new chain starts and none runs when this returns: the address space may be rewritten. */
+static void
+queue_hold_idle(void)
+{
+	lck_mtx_lock(&queue_lock);
+	queue_holds++;
+	while (slots[0].running || slots[1].running) {
+		(void)lck_mtx_sleep(&queue_lock, LCK_SLEEP_DEFAULT, (event_t)&queue_done_chan, THREAD_UNINT);
+	}
+	lck_mtx_unlock(&queue_lock);
+}
+
+static void
+queue_release(void)
+{
+	lck_mtx_lock(&queue_lock);
+	queue_holds--;
+	start_ready();
+	thread_wakeup((event_t)&queue_thread_chan);
+	lck_mtx_unlock(&queue_lock);
+}
+
+static void
+queue_start(void)
+{
+	int on = 1;
+	thread_t thread;
+
+	(void)PE_parse_boot_argn("sweetmaliasync", &on, sizeof(on));
+	nanoseconds_to_absolutetime((uint64_t)JOB_TIMEOUT_MS * NSEC_PER_MSEC, &queue_timeout);
+	slots[0].js = JS0;
+	slots[1].js = JS1;
+	if (on && kernel_thread_start(queue_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		queue_mode = 1;
+		printf("SWEET MALI: job queue on: chains run while their programs go on, both slots at once\n");
+	} else {
+		queue_mode = 0;
+		printf("SWEET MALI: job queue off (sweetmaliasync=0): every chain runs to its end in its caller\n");
+	}
+}
+
+/* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
+ * For the SweetMali service: the queue, fences and waits (patch 0135)
+ * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * */
+
+bool
+sweet_mali_async(void)
+{
+	return queue_on();
+}
+
+/* The chain queued after the fences in `deps`: its fence, 0 if there is no queue. */
+uint64_t
+sweet_mali_queue(uint64_t chain, bool fragment, const uint64_t *deps, uint32_t ndeps)
+{
+	return queue_on() ? queue_submit(chain, fragment, deps, ndeps) : 0;
+}
+
+bool
+sweet_mali_fence_done(uint64_t fence)
