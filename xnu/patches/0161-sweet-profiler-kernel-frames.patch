+/*
+ * 0161: the kernel frames under an interrupted kernel pc: the saved lr, then the return addresses of the fp chain,
+ * as long as fp stays inside the thread's kernel stack (an fp elsewhere, the interrupt stack for one, ends it).
+ * The profiler's cross-call is only taken where interrupts are enabled again, so time spent with them masked shows
+ * as one pc in ml_set_interrupts_enabled (80% of launchd's kernel time, round aj); these frames say who masked them.
+ */
+static void
+sweet_prof_kframes(thread_t th, arm_saved_state_t *st, uint64_t *out, int max)
+{
+	vm_offset_t lo = th->kernel_stack, hi = lo + kernel_stack_size;
+	uint64_t fp = get_saved_state_fp(st);
+	int n = 0;
+
+	out[n++] = VM_KERNEL_UNSLIDE(get_saved_state_lr(st));
+	while (n < max && lo != 0 && fp >= lo && fp + 16 <= hi && (fp & 7) == 0) {
+		const uint64_t *frame = (const uint64_t *)fp;
+
+		out[n++] = VM_KERNEL_UNSLIDE(frame[1]);
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+}
