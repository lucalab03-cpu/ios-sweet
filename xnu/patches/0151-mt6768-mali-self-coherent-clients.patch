+	/*
+	 * The processor's writes to imported pages, and (sweetmaliwc=0) to the small buffers the chain names, to memory.
+	 * Not for a self-coherent client (0151): it cleans exactly the pages a command uses, by address, before the commit.
+	 */
+	for (uint32_t i = 0; !fSelfCoherent && i < SWEET_MALI_BUFFERS; i++) {
 		if (fBuffers[i].imported != NULL) {
 			fBuffers[i].imported->performOperation(kIOMemoryIncoherentIOStore, 0, fBuffers[i].size);
 		}
@@ -1117,9 +1140,11 @@ SweetMaliUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments
