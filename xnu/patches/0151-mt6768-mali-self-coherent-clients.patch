+/*
+ * Mode bit 2 (patch 0151): the client cleans the imported pages a command uses before committing it and invalidates
+ * them after it ends, by address (DC CIVAC reaches every core's caches). Here they were cleaned all of them before
+ * every SUBMIT and invalidated after every wait: the 2026-11-25 profile had backboardd's render threads 52% of their
+ * kernel time in clean_mmu_dcache/CleanPoC_DcacheRegion (14 MB imported, two 5.9 MB surfaces, set/way cleans of the
+ * local core only). Boot-arg sweetmaliself=0 refuses the bit, so the kernel cleans as before.
+ */
+static bool
+sweet_mali_self_coherent(void)
+{
+	static int answer = -1;
+	if (answer < 0) {
+		int v = 1;
+		PE_parse_boot_argn("sweetmaliself", &v, sizeof(v));
+		answer = v != 0;
+	}
+	return answer != 0;
+}
+
 /* How many chains a queued client may have in front of the GPU (patch 0136): boot-arg sweetmaliahead, default 8. */
