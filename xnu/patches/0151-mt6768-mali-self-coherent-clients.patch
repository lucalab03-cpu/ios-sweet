-		IOLog("SweetMali: a client asks for mode %u: %s\n", r.mode.mode, fAsync ? "queued" : "every chain run to its end");
+		fAsync = (r.mode.mode & 1) != 0 && (r.mode.mode & ~3u) == 0 && sweet_mali_async() && fSubmits == 0;
+		fSelfCoherent = fAsync && (r.mode.mode & 2) != 0 && sweet_mali_self_coherent();
+		r.mode.result = (fAsync ? 1 : 0) | (fSelfCoherent ? 2 : 0);
+		IOLog("SweetMali: a client asks for mode %u: %s%s\n", r.mode.mode, fAsync ? "queued" : "every chain run to its end",
+		    fSelfCoherent ? ", it keeps its imported pages coherent itself (no cleaning here)" : "");
 		break;
